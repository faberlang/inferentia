# ---------------------------------------------------------------------------
# Minimal product-owned JSON parser (D3 exception: norma:json is deferred;
# the second-caller rule triggers the Norma codec delivery). Bounded to the
# fixed /generate schema: one flat object whose values are strings or
# numbers. The common string escapes are decoded; \uXXXX is rejected with a
# typed cause (documented bound). Numbers are bounded (int-form ≤ 18 digits,
# float-form ≤ 24 chars); out-of-range values fail closed with a typed cause.
# ---------------------------------------------------------------------------

class JsonCursor {
    string text
    int pos
}

# kind: 1 = string, 2 = integer, 3 = float; 0 = error.
class JsonScalar {
    bool ok
    string error
    int kind
    string text
    int int_value
    float float_value
    int pos
}

fn json_fail(string error, int pos) → JsonScalar {
    return JsonScalar { ok = false, error = error, kind = 0, text = "", int_value = 0, float_value = 0.0, pos = pos }
}

# One UTF-8 character at the cursor ("" past the end).
fn json_char(JsonCursor c) → string {
    const int len ← c.text.length()
    if c.pos ≥ len { return "" }
    return c.text.slice(c.pos, c.pos + 1)
}

fn json_skip_ws(JsonCursor c) → JsonCursor {
    var JsonCursor out ← c
    var bool go ← true
    while go {
        const string ch ← json_char(out)
        if ch ≡ " " or ch ≡ "\t" or ch ≡ "\n" or ch ≡ "\r" {
            out ← JsonCursor { text = out.text, pos = out.pos + 1 }
        } else {
            go ← false
        }
    }
    return out
}

fn json_is_digit(string ch) → bool {
    return (ch ≡ "0") or (ch ≡ "1") or (ch ≡ "2") or (ch ≡ "3") or (ch ≡ "4") or (ch ≡ "5") or (ch ≡ "6") or (ch ≡ "7") or (ch ≡ "8") or (ch ≡ "9")
}

# Parse a JSON string starting at the opening quote.
fn json_parse_string(JsonCursor c) → JsonScalar {
    var JsonCursor cur ← JsonCursor { text = c.text, pos = c.pos + 1 }
    var string out ← ""
    var bool done ← false
    var string err ← ""
    while (not done) and (err ≡ "") {
        const string ch ← json_char(cur)
        if ch ≡ "" {
            err ← "malformed JSON: unterminated string"
        } elif ch ≡ "\"" {
            done ← true
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        } elif ch ≡ "\\" {
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            const string esc ← json_char(cur)
            if esc ≡ "" {
                err ← "malformed JSON: unterminated string"
            } elif esc ≡ "\"" {
                out ← out + "\""
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "\\" {
                out ← out + "\\"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "/" {
                out ← out + "/"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "b" {
                out ← out + "\b"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "f" {
                out ← out + "\f"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "n" {
                out ← out + "\n"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "r" {
                out ← out + "\r"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "t" {
                out ← out + "\t"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "u" {
                err ← "malformed JSON: \\uXXXX escapes are not supported by the minimal I1 JSON parser"
            } else {
                err ← "malformed JSON: unknown escape \\" + esc
            }
        } else {
            out ← out + ch
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        }
    }
    return JsonScalar { ok = err ≡ "", error = err, kind = 1, text = out, int_value = 0, float_value = 0.0, pos = cur.pos }
}

# Parse a JSON number starting at '-' or a digit. Integer-form numbers (no
# '.', 'e', 'E') parse as int; float-form numbers parse as float.
fn json_parse_number(JsonCursor c) → JsonScalar {
    const string body_text ← c.text
    const int start ← c.pos
    var JsonCursor cur ← c
    if json_char(cur) ≡ "-" {
        cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
    }
    var bool digits ← false
    var bool go ← true
    while go {
        const string ch ← json_char(cur)
        if json_is_digit(ch) {
            digits ← true
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        } else {
            go ← false
        }
    }
    if not digits {
        return json_fail("malformed JSON: invalid number", start)
    }
    var bool is_float ← false
    if json_char(cur) ≡ "." {
        is_float ← true
        cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        var bool frac ← false
        go ← true
        while go {
            const string ch ← json_char(cur)
            if json_is_digit(ch) {
                frac ← true
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } else {
                go ← false
            }
        }
        if not frac {
            return json_fail("malformed JSON: invalid fraction", cur.pos)
        }
    }
    const string e_ch ← json_char(cur)
    if e_ch ≡ "e" or e_ch ≡ "E" {
        is_float ← true
        cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        const string sign ← json_char(cur)
        if sign ≡ "+" or sign ≡ "-" {
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        }
        var bool exp ← false
        go ← true
        while go {
            const string ch ← json_char(cur)
            if json_is_digit(ch) {
                exp ← true
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } else {
                go ← false
            }
        }
        if not exp {
            return json_fail("malformed JSON: invalid exponent", cur.pos)
        }
    }
    const int token_len ← cur.pos - start
    if (not is_float) and (token_len > 18) {
        return json_fail("malformed JSON: integer out of range", cur.pos)
    }
    if is_float and (token_len > 24) {
        return json_fail("malformed JSON: number too long", cur.pos)
    }
    const string token ← body_text.slice(start, cur.pos)
    if is_float {
        const float fv ← token ↦ float ⇥ 0.0
        return JsonScalar { ok = true, error = "", kind = 3, text = token, int_value = 0, float_value = fv, pos = cur.pos }
    }
    const int iv ← token ↦ int ⇥ 0
    return JsonScalar { ok = true, error = "", kind = 2, text = token, int_value = iv, float_value = 0.0, pos = cur.pos }
}

# Parse a /generate request body (D3) into the fixed schema. Unknown fields,
# duplicate fields, wrong types, and malformed JSON reject with typed causes.
fn json_parse_generate_body(string body) → GenerateRequest {
    const string body_text ← body
    const JsonCursor start ← JsonCursor { text = body_text, pos = 0 }
    var JsonCursor cur ← json_skip_ws(start)
    if json_char(cur) ≠ "{" {
        return rejected_generate_request("malformed JSON: expected an object")
    }
    cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }

    var GenerateRequest out ← fresh_generate_request()
    var bool go ← true
    var bool after_comma ← false
    while go {
        cur ← json_skip_ws(cur)
        const string key_start ← json_char(cur)
        if key_start ≡ "}" {
            # A `}` directly after `{` is the empty object; a `}` after a
            # comma is a trailing-comma reject (fail closed).
            if after_comma {
                return rejected_generate_request("malformed JSON: trailing comma")
            }
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            go ← false
            break
        }
        if key_start ≠ "\"" {
            return rejected_generate_request("malformed JSON: expected a field name")
        }
        const JsonScalar key ← json_parse_string(cur)
        if not key.ok {
            return rejected_generate_request(key.error)
        }
        const string fname ← key.text
        cur ← json_skip_ws(JsonCursor { text = cur.text, pos = key.pos })
        if json_char(cur) ≠ ":" {
            return rejected_generate_request("malformed JSON: expected ':' after field '" + fname + "'")
        }
        cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        cur ← json_skip_ws(cur)

        const string vch ← json_char(cur)
        var JsonScalar val ← json_fail("malformed JSON: unexpected value", cur.pos)
        if vch ≡ "\"" {
            val ← json_parse_string(cur)
        } elif vch ≡ "-" or json_is_digit(vch) {
            val ← json_parse_number(cur)
        } else {
            return rejected_generate_request("field '" + fname + "': value must be a JSON string or number (minimal I1 parser)")
        }
        if not val.ok {
            return rejected_generate_request(val.error)
        }
        cur ← json_skip_ws(JsonCursor { text = cur.text, pos = val.pos })

        # Dispatch the fixed /generate schema. Unknown fields are reject rows
        # mirroring the gradus imperium_admissum vocabulary (never silently
        # ignored); duplicates fail closed too.
        if fname ≡ "prompt" {
            if out.has_prompt {
                return rejected_generate_request("duplicate field 'prompt'")
            }
            if val.kind ≠ 1 {
                return rejected_generate_request("field 'prompt' must be a JSON string")
            }
            if val.text ≡ "" {
                return rejected_generate_request("field 'prompt' must not be empty")
            }
            out ← generate_request_with_prompt(out, val.text)
        } elif fname ≡ "max_tokens" {
            if out.has_max_tokens {
                return rejected_generate_request("duplicate field 'max_tokens'")
            }
            if val.kind ≠ 2 {
                return rejected_generate_request("field 'max_tokens' must be an integer")
            }
            out ← generate_request_with_max_tokens(out, val.int_value)
        } elif fname ≡ "max_prompt" {
            if out.has_max_prompt {
                return rejected_generate_request("duplicate field 'max_prompt'")
            }
            if val.kind ≠ 2 {
                return rejected_generate_request("field 'max_prompt' must be an integer")
            }
            out ← generate_request_with_max_prompt(out, val.int_value)
        } elif fname ≡ "temperature" {
            if out.has_temperature {
                return rejected_generate_request("duplicate field 'temperature'")
            }
            if (val.kind ≠ 2) and (val.kind ≠ 3) {
                return rejected_generate_request("field 'temperature' must be a JSON number")
            }
            const float tv ← if_float(val.kind ≡ 2, (val.int_value ↦ float), val.float_value)
            out ← generate_request_with_temperature(out, tv)
        } elif fname ≡ "top_k" {
            if out.has_top_k {
                return rejected_generate_request("duplicate field 'top_k'")
            }
            if val.kind ≠ 2 {
                return rejected_generate_request("field 'top_k' must be an integer")
            }
            out ← generate_request_with_top_k(out, val.int_value)
        } elif fname ≡ "top_p" {
            if out.has_top_p {
                return rejected_generate_request("duplicate field 'top_p'")
            }
            if (val.kind ≠ 2) and (val.kind ≠ 3) {
                return rejected_generate_request("field 'top_p' must be a JSON number")
            }
            const float pv ← if_float(val.kind ≡ 2, (val.int_value ↦ float), val.float_value)
            out ← generate_request_with_top_p(out, pv)
        } elif fname ≡ "min_p" {
            if out.has_min_p {
                return rejected_generate_request("duplicate field 'min_p'")
            }
            if (val.kind ≠ 2) and (val.kind ≠ 3) {
                return rejected_generate_request("field 'min_p' must be a JSON number")
            }
            const float mv ← if_float(val.kind ≡ 2, (val.int_value ↦ float), val.float_value)
            out ← generate_request_with_min_p(out, mv)
        } elif fname ≡ "repeat_penalty" {
            if out.has_repeat_penalty {
                return rejected_generate_request("duplicate field 'repeat_penalty'")
            }
            if (val.kind ≠ 2) and (val.kind ≠ 3) {
                return rejected_generate_request("field 'repeat_penalty' must be a JSON number")
            }
            const float rv ← if_float(val.kind ≡ 2, (val.int_value ↦ float), val.float_value)
            out ← generate_request_with_repeat_penalty(out, rv)
        } elif fname ≡ "seed" {
            if out.has_seed {
                return rejected_generate_request("duplicate field 'seed'")
            }
            if val.kind ≠ 2 {
                return rejected_generate_request("field 'seed' must be an integer")
            }
            out ← generate_request_with_seed(out, val.int_value)
        } else {
            return rejected_generate_request("unknown field '" + fname + "' (imperium_admissum reject — never silently ignored)")
        }

        cur ← json_skip_ws(cur)
        const string sep ← json_char(cur)
        if sep ≡ "," {
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            after_comma ← true
        } elif sep ≡ "}" {
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            after_comma ← false
            go ← false
        } else {
            return rejected_generate_request("malformed JSON: expected ',' or '}'")
        }
    }

    # No trailing content allowed.
    const JsonCursor end ← json_skip_ws(cur)
    if end.pos < body_text.length() {
        return rejected_generate_request("malformed JSON: trailing content after object")
    }
    if not out.has_prompt {
        return rejected_generate_request("missing required field 'prompt'")
    }
    return out
}

# Value-preserving picks (the toolchain has no inline if-expression).
fn if_int(bool cond, int a, int b) → int {
    if cond { return a }
    return b
}

fn if_float(bool cond, float a, float b) → float {
    if cond { return a }
    return b
}

# ---------------------------------------------------------------------------
# Generation config (the nine gradus GeneratioConfigura fields, D2/D4)
# ---------------------------------------------------------------------------

class GenerateConfig {
    int contextus
    int magna_promptus
    int maxima_verborum
    int semen
    float temperatura
    int top_k
    float top_p
    float min_p
    float poena_repetitionis
}

# The effective prompt-token admission bound: the configured --max-prompt, or
# the model context limit when unset (0 sentinel, same convention as context).
fn effective_max_prompt(ServeConfig server) → int {
    return if_int(server.max_prompt ≡ 0, model_context_limit(), server.max_prompt)
}

# The effective live prompt: the --prompt text, or the frozen fixture when
# unset (the parser rejects an empty --prompt, so "" is a safe sentinel).
fn effective_prompt(ServeConfig server) → string {
    if server.prompt ≠ "" { return server.prompt }
    return frozen_prompt_text()
}

# D2 precedence: body fields override server flags, flags override defaults.
# `magna_promptus` is the prompt-token admission bound, not a request batch:
# the engine rejects any prompt longer than it with "prompt length exceeds
# max_prompt" (gradus generation/dense.fab:237).
fn build_generate_config(GenerateRequest req, ServeConfig server) → GenerateConfig {
    const int contextus ← if_int(server.context ≡ 0, model_context_limit(), server.context)
    const int magna_promptus ← if_int(req.has_max_prompt, req.max_prompt, effective_max_prompt(server))
    const int maxima ← if_int(req.has_max_tokens, req.max_tokens, server.max_tokens)
    const int seed ← if_int(req.has_seed, req.seed, server.seed)
    const float temperatura ← if_float(req.has_temperature, req.temperature, 0.0)
    const int top_k ← if_int(req.has_top_k, req.top_k, 0)
    const float top_p ← if_float(req.has_top_p, req.top_p, 1.0)
    const float min_p ← if_float(req.has_min_p, req.min_p, 0.0)
    const float poena ← if_float(req.has_repeat_penalty, req.repeat_penalty, 1.0)
    return GenerateConfig {
        contextus = contextus,
        magna_promptus = magna_promptus,
        maxima_verborum = maxima,
        semen = seed,
        temperatura = temperatura,
        top_k = top_k,
        top_p = top_p,
        min_p = min_p,
        poena_repetitionis = poena
    }
}

# ---------------------------------------------------------------------------
# Prompt encode (the "encode" phase of the generation pipeline)
# ---------------------------------------------------------------------------

class EncodeResult {
    bool ok
    string error
    list<int> ids
}

# Text → token ids (the "encode" phase) through the admitted model's real
# G3 tokenizer (carried on ResidentModel). `tokenizator.tokenize` is the
# provider encode route — SMOLLM scanner + parse-special on. A typed
# TokenizerError fails closed with its message; the request path maps that
# to 400.
#
# The catch arm stays straight-line: the MIR stepper (`faber test`) cannot
# lower a conditional inside a `cape` block that wraps a library-provider
# call (recorded toolchain limitation, cf. BD-3).
fn encode_prompt(tokenizator.Tokenizer tok, string prompt) → EncodeResult {
    do {
        const list<int> ids ← tokenizator.tokenize(tok, prompt)
        return EncodeResult { ok = true, error = "", ids = ids }
    }
    catch err {
        return EncodeResult { ok = false, error = "prompt encode failed: " + err.message, ids = [] }
    }
}

# ---------------------------------------------------------------------------
# Response assembly (D3) + error classification
# ---------------------------------------------------------------------------

# Ids → detokenized text (G3 `tokenizator.decode` over the admitted
# tokenizer). Decode happens before any response body is assembled or any
# stream is opened: a typed TokenizerError fails closed with its message
# instead of emitting a partial body. The id list in `tokens` stays the
# machine surface.
#
# Straight-line catch arm for the same BD-3 stepper constraint as
# encode_prompt.
class DecodeResult {
    bool ok
    string error
    string text
}

fn tokens_text(tokenizator.Tokenizer tok, list<int> tokens) → DecodeResult {
    do {
        return DecodeResult { ok = true, error = "", text = tokenizator.decode(tok, tokens) }
    }
    catch err {
        return DecodeResult { ok = false, error = "token decode failed: " + err.message, text = "" }
    }
}

fn tokens_json(list<int> tokens) → string {
    var string out ← "["
    var int i ← 0
    while i < tokens.length() {
        if i > 0 { out ← out + "," }
        const int t ← tokens.get(i) coalesce 0
        out ← out + (t ↦ string)
        i ← i + 1
    }
    return out + "]"
}

# D3 finish_reason: "length" at max_tokens; "eos" when the engine stopped
# early at an admitted tokenizer EOG id (the pinned engine excludes EOG ids
# from the top-1 surface, so with the frozen row the ceiling always binds).
fn finish_reason(int generated, int max_tokens) → string {
    if generated ≥ max_tokens { return "length" }
    return "eos"
}

# The /generate response body. `model` carries the minimal identity facts
# held by this server (sha256 + path); the full /model identity surface is
# U3 (not yet landed). `text` is the pre-decoded detokenized string (the
# caller fails closed before assembly); `tokens` keeps the machine surface.
fn generate_response_body(ServerState st, string text, list<int> tokens, list<int> prompt_ids, int max_tokens) → string {
    const int pn ← prompt_ids.length()
    const int cn ← tokens.length()
    const int total ← pn + cn
    const string reason ← finish_reason(cn, max_tokens)
    return "{\"model\":{\"sha256\":\"" + json_escape(st.sha256) + "\",\"path\":\"" + json_escape(st.model_path) + "\"},\"text\":\"" + json_escape(text) + "\",\"tokens\":" + tokens_json(tokens) + ",\"finish_reason\":\"" + reason + "\",\"usage\":{\"prompt_tokens\":" + (pn ↦ string) + ",\"completion_tokens\":" + (cn ↦ string) + ",\"total_tokens\":" + (total ↦ string) + "}}"
}

# JSON-string escape for health/error bodies (typed causes carry quotes,
# e.g. unknown config field "bogus"; a configured model path may carry
# backslashes; multi-line error text carries control characters). Escaping
# order matters: backslashes first, then quotes, then control characters —
# reversing the first two would double the inserted backslashes.
fn json_escape(string s) → string {
    return s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
}

fn error_body(string error) → string {
    return "{\"error\":\"" + json_escape(error) + "\"}"
}

# D3: 503 before ready carries the state.
fn state_body(ServerState st) → string {
    return "{\"state\":\"" + st.state + "\",\"error\":\"" + json_escape(st.error_text) + "\"}"
}

# G2 generate / construct_generation error → HTTP status. Request-side
# causes are the typed ConfiguraInvalida rows (field domains, prompt fit,
# the context cursor). Engine-side failures (prefill/forward/decode) are 500.
fn classify_generate_error(string err) → int {
    if err.starts_with("maximum generated tokens") or err.starts_with("needs at least one prompt token") or err.starts_with("prompt length") or err.starts_with("seed must") or err.starts_with("temperature must") or err.starts_with("top-p must") or err.starts_with("top-k must") or err.starts_with("min-p must") or err.starts_with("repetition penalty") or err.starts_with("context length") or err.starts_with("prompt batch") or err.starts_with("malformed generation") or err.starts_with("unknown generation") {
        return 400
    }
    return 500
}

# Request-body extraction. The provider delivers valor octeti. `value ↦ bytes`
# now extracts `Valor::Octeti`; UTF-8 decode is `bytes ↦ string`. A string
# valor (tests / future text carriers) is taken as-is. The gap marker is only
# for a failed octeti→text decode (invalid UTF-8).
fn request_body_text(value body_value) → string {
    if body_value is string {
        return body_value ↦ string
    }
    const bytes raw ← body_value ↦ bytes ⇥ ||
    return raw ↦ string ⇥ body_read_gap_marker()
}

fn request_body_from_raw(value request) → string {
    if request is map<string, value> {
        const map<string, value> tab ← request ↦ map<string, value>
        return request_body_text(tab.get("body"))
    }
    return body_read_gap_marker()
}

# ---------------------------------------------------------------------------
# Host provider routes through `norma:http/server` (H6).
# ---------------------------------------------------------------------------

fn json_headers() → headers.Headers {
    var headers.Headers head ← headers.empty()
    if head.append("content-type", "application/json") {
    }
    return head
}

fn reply_json(server.Incoming incoming, int status, string body) → void {
    server.reply(incoming, status, json_headers(), body)
}

fn wants_sse(server.Incoming incoming) → bool {
    const string ∪ null accept ← incoming.req.header("accept")
    if accept not is null {
        const string a ← accept ↦ string
        if a.contains("text/event-stream") {
            return true
        }
    }
    const string ∪ null stream ← incoming.req.query_field("stream")
    if stream not is null {
        const string s ← stream ↦ string
        if s ≡ "1" or s ≡ "true" {
            return true
        }
    }
    return false
}

# One SSE `token` event per generated id, then a `done` event with the JSON
# body. Generation is still a batch call; this is the I1 wire stream. The
# detokenized `text` arrives pre-decoded — decode fails closed before the
# stream opens, so no partial body is emitted.
fn send_generate_stream(server.Incoming incoming, ServerState st, string text, list<int> tokens, list<int> prompt_ids, int max_tokens) → void {
    const server.Stream stream ← server.open_sse(incoming)
    var int i ← 0
    while i < tokens.length() {
        const int t ← tokens.get(i) coalesce 0
        const sse.Event ev ← sse.Event { name = "token", data = t ↦ string, id = "", retry = "" }
        server.send_event(stream, ev)
        i ← i + 1
    }
    const sse.Event done ← sse.Event { name = "done", data = generate_response_body(st, text, tokens, prompt_ids, max_tokens), id = "", retry = "" }
    server.send_event(stream, done)
    server.finish_stream(stream, server.keep_alive(incoming.req.headers))
}

# Write text to stdout without a trailing newline.
fn stdout_write(string text) → void {
    return call 'consolum:dic' (text) ↦ void
}

# Write a line to stderr.
fn stderr_write(string text) → void {
    return call 'consolum:mone' (text) ↦ void
}

# D5 exit-code delivery: terminate the process with the given code (0 clean
# shutdown, 2 admission/load failure at shutdown). The route is the language's
# process-exit primitive (`processus:exi`); never returns on success — the
# generated wrapper panics if it returns.
fn exit_with(int code) → void {
    return call 'processus:exi' (code) ↦ void
}

# ---------------------------------------------------------------------------
# Gradus provider composition (ruling 2615e6a9)
#
# Admit: path → solum:digestio + solum:hauri → gguf.admit (pinned SmolLM2
# counts). Tokenize: G3. Generate: G2 generate_dense_with_stop over a resident dense engine.
# ---------------------------------------------------------------------------

# Pinned SmolLM2 row counts (gi0-model-contract / gguf.proba).
fn pinned_expect_kv() → int { return 37 }
fn pinned_expect_tensors() → int { return 290 }
fn pinned_expect_elements() → int { return 361821120 }
fn pinned_expect_f32() → int { return 65 }
fn pinned_expect_q4k() → int { return 16 }
fn pinned_expect_q5() → int { return 176 }
fn pinned_expect_q6() → int { return 16 }
fn pinned_expect_q8() → int { return 17 }

fn bytes_as_u8(bytes raw) → list<int<u8>> {
    var list<int<u8>> out ← []
    var int i ← 0
    while i < raw.length() {
        out.append(raw.get(i) coalesce (0 ∷ int<u8>))
        i ← i + 1
    }
    return out
}

# Host IO payloads are String. A ⇥ string wrapper lets them propagate
# instead of aborting; admit_model's cape maps them into CapsulaMala.
fn host_digestio(string path) → string ⇥ string {
    return call 'solum:digestio' (path) ↦ string
}

fn host_hauri(string path) → bytes ⇥ string {
    return call 'solum:hauri' (path) ↦ bytes
}

# Path → host digest + bytes → gradus admit. Returns the carried digest.
fn admit_model(string path) → string ⇥ gguf.GgufError {
    var string digest ← ""
    var bytes raw ← ||
    do {
        digest ← host_digestio(path)
        raw ← host_hauri(path)
    }
    catch err {
        throw variant BadCapsule { message = err }
    }
    const list<int<u8>> data ← bytes_as_u8(raw)
    const capsule.Capsule cap ← gguf.admit(data, digest, pinned_expect_kv(), pinned_expect_tensors(), pinned_expect_elements(), pinned_expect_f32(), pinned_expect_q4k(), pinned_expect_q5(), pinned_expect_q6(), pinned_expect_q8())
    return cap.digest()
}

fn to_generation_config(GenerateConfig cfg, list<int> eog_ids) → config.GenerationConfig ⇥ config.GenerationError {
    return config.construct_generation(cfg.contextus, cfg.magna_promptus, cfg.maxima_verborum, cfg.semen, cfg.temperatura ∷ f32, cfg.top_k, cfg.top_p ∷ f32, cfg.min_p ∷ f32, cfg.poena_repetitionis ∷ f32, eog_ids)
}

# Resident dense weights + the admitted G3 tokenizer for /generate (loaded
# once after admit). The tokenizer carried here is the one built from the
# admitted manifest — the same tables the EOG stop set came from.
class ResidentModel {
    bool ready
    dense_gen.DenseEngine engine
    tensor.NumericBlock embed
    tensor.NumericBlock norm_s
    list<list<tensor.NumericBlock>> strata
    structure.KVStructure structure
    gguf_manifest.GgufManifest manifest
    tokenizator.Tokenizer tokenizer
    list<int> eog_ids
}

fn empty_manifest() → gguf_manifest.GgufManifest {
    return gguf_manifest.GgufManifest {
        identity = artifact.ContentIdentity { algorithm = "sha-256", digest = "", length = 0 },
        version = 0,
        alignment = 0,
        data_start = 0,
        artifact_length = 0,
        metadata = [],
        tensors = []
    }
}

# The unready placeholder tokenizer: empty tables. `build_tables` rejects
# an empty vocabulary, so the placeholder is the class literal; any encode
# against it fails closed with a typed UnknownTrace cause (never read on
# the serve path — /generate is 503-gated before ready).
fn empty_tokenizer() → tokenizator.Tokenizer {
    var map<string, int> no_vocab ← empty
    var map<string, int> no_merges ← empty
    return tokenizator.Tokenizer {
        words = [],
        vocab = no_vocab,
        concursus = no_merges,
        special_texts = [],
        specialia_ids = [],
        eog = [],
        add_bos = false,
        chat_template = "",
        multitudo = 0
    }
}

fn empty_resident() → ResidentModel {
    return ResidentModel {
        ready = false,
        engine = dense_gen.default_dense_engine(),
        embed = tensor.default(),
        norm_s = tensor.default(),
        strata = [],
        structure = structure.default_kv_structure(),
        manifest = empty_manifest(),
        tokenizer = empty_tokenizer(),
        eog_ids = []
    }
}

fn fresh_resident_caches(ResidentModel model) → list<kv.KVCache> {
    do {
        return dense.empty_caches(model.structure, "smollm2", "360m", "f32-staged", "smollm")
    }
    catch err {
        panic "empty caches failed: " + err.message
    }
}

# ---------------------------------------------------------------------------
# I-live — one-shot G2 generate_dense_with_stop on an admitted GGUF
#
# Serve loads the same resident dense weights and calls
# generate_dense_with_stop with an explicit StopPolicy (default eog_stop).
# live is the composed provider run: admit → inspect → G3 tokenizer
# tables → dense weights → generate_dense_with_stop (eog_stop by default;
# --ignore-eos selects ignore_eos and the 16-token golden compare).
# ---------------------------------------------------------------------------

fn pinned_digest() → string {
    return "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2"
}

fn pinned_data_offset() → int {
    return 1787040
}

fn pinned_slice_cap() → int {
    return 16777216
}

# U5 / record.json generated_tokens[0..16] (i1-validation-u5). The
# **ignore_eos** continuation — the EOG id is sample-suppressed only under
# ignore_eos (gradus decoder.fab:140-144), so this golden compares only
# under --ignore-eos.
fn golden_tokens_16() → list<int> {
    return [30, 198, 198, 504, 808, 6330, 314, 253, 2232, 4814, 282, 1027, 28, 979, 260, 1796]
}

# The frozen fixture's greedy eog_stop continuation (generate-gate header
# fact: the EOG id terminates the run, so the run is [30, 2]).
fn frozen_eog_continuation() → list<int> {
    return [30, 2]
}

fn live_file_size(string path) → int {
    return call 'solum:mensura' (path) ↦ int
}

fn live_read_range(string path, int start, int length) → bytes {
    const list<value> args ← [path, start, length]
    return call 'solum:partem' (args) ↦ bytes
}

fn live_range(string path, int total, int initium, int longitudo) → bytes ⇥ gguf_manifest.GgufManifestError {
    if initium < 0 or longitudo < 0 or initium > total - longitudo {
        throw variant BadSource { message = "range request exceeds the artifact" }
    }
    const bytes raw ← live_read_range(path, initium, longitudo)
    if raw.length() ≠ longitudo {
        throw variant BadSource { message = "short range read" }
    }
    return raw
}

fn live_prefix_range(list<int> prefix, int initium, int longitudo) → bytes ⇥ gguf_manifest.GgufManifestError {
    if initium < 0 or longitudo < 0 or initium > prefix.length() - longitudo {
        throw variant BadSource { message = "inspection attempted to read the tensor data region" }
    }
    const list<int> segment ← prefix.slice(initium, initium + longitudo)
    const bytes raw ← segment ↦ bytes
    return raw
}

fn live_ends(string s, string tail) → bool {
    if tail.length() > s.length() { return false }
    return s.slice(s.length() - tail.length(), s.length()) ≡ tail
}

fn live_slot(string nomen) → int {
    if live_ends(nomen, ".input_layernorm") { return 0 }
    if live_ends(nomen, ".self_attn.q_proj") { return 1 }
    if live_ends(nomen, ".self_attn.k_proj") { return 2 }
    if live_ends(nomen, ".self_attn.v_proj") { return 3 }
    if live_ends(nomen, ".self_attn.o_proj") { return 4 }
    if live_ends(nomen, ".post_attention_layernorm") { return 5 }
    if live_ends(nomen, ".mlp.gate_proj") { return 6 }
    if live_ends(nomen, ".mlp.up_proj") { return 7 }
    if live_ends(nomen, ".mlp.down_proj") { return 8 }
    return -1
}

fn live_ids_text(list<int> ids) → string {
    var string out ← "["
    var int i ← 0
    while i < ids.length() {
        if i > 0 { out ← out + ", " }
        out ← out + ((ids.get(i) coalesce 0) ↦ string)
        i ← i + 1
    }
    return out + "]"
}

# Space-joined ids for the one-shot `ids=` line (recipes grep `^ids=30 2`).
fn live_ids_flat(list<int> ids) → string {
    var string out ← ""
    var int i ← 0
    while i < ids.length() {
        if i > 0 { out ← out + " " }
        out ← out + ((ids.get(i) coalesce 0) ↦ string)
        i ← i + 1
    }
    return out
}

fn live_block_elements(tensor_view.TensorView v) → int {
    match v.layout {
        case gguf_manifest.Known const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            return elementa_per_blockum
        }
        case gguf_manifest.Unknown const typo {
            return 0
        }
    }
}

fn live_window(int remaining, int block) → int {
    if remaining ≤ pinned_slice_cap() { return remaining }
    const int aligned ← (pinned_slice_cap() / block) * block
    if aligned < block { return block }
    return aligned
}

fn live_limits(gguf_manifest.GgufManifest m, string gguf_name) → tuple<int, int> {
    do {
        return gguf_manifest.payload_limit(m, gguf_name)
    }
    catch err {
        panic "payload range failed for " + gguf_name + ": " + err.message
    }
}

fn live_bind(gguf_manifest.GgufManifest m, tensor_payload.TensorPayload p) → tensor_view.TensorView {
    do {
        return tensor_view.links(m, p)
    }
    catch err {
        panic "view bind failed for " + p.name + ": " + err.message
    }
}

fn live_slice(tensor_view.TensorView v, int off, int n, (int, int) → bytes ⇥ gguf_manifest.GgufManifestError fons) → list<f32> {
    do {
        return tensor_view.materialize_slice(v, off, n, fons)
    }
    catch err {
        panic "window materialize failed for " + v.name + ": " + err.message
    }
}

fn live_tensor(list<f32> datos, list<int> forma) → tensor.NumericBlock {
    do {
        return tensor.construct(datos, forma)
    }
    catch err {
        panic "tensor construct failed: " + err.message
    }
}

fn live_materialize(string via, int total, gguf_manifest.GgufManifest m, string gguf_name) → tensor.NumericBlock {
    const tuple<int, int> limes ← live_limits(m, gguf_name)
    const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
        name = gguf_name,
        absolute_start = limes[0],
        length = limes[1],
        bytes = ||
    }
    const tensor_view.TensorView v ← live_bind(m, p)
    const int block ← live_block_elements(v)
    if block < 1 {
        panic "tensor layout has no block size: " + gguf_name
    }
    var list<f32> datos ← []
    var int off ← 0
    while off < v.elements {
        const int n ← live_window(v.elements - off, block)
        const list<f32> part ← live_slice(
            v,
            off,
            n,
            (int initium, int longitudo) → bytes ⇥ gguf_manifest.GgufManifestError ∴ live_range(via, total, initium, longitudo)
        )
        var int pi ← 0
        while pi < part.length() {
            datos.append(part.get(pi) coalesce (0.0 ∷ f32))
            pi ← pi + 1
        }
        off ← off + n
    }
    return live_tensor(datos, v.shape)
}

fn live_gguf_name(string family, int stratum) → string {
    if family ≡ "model.embed_tokens" { return "token_embd.weight" }
    if family ≡ "model.norm" { return "output_norm.weight" }
    if family ≡ "lm_head" { return "token_embd.weight" }
    if stratum < 0 or stratum ≥ 32 {
        panic "layer index outside the frozen llama layer range: " + (stratum ↦ string)
    }
    if family ≡ "model.layers.input_layernorm" { return ("blk." + (stratum ↦ string)) + ".attn_norm.weight" }
    if family ≡ "model.layers.self_attn.q_proj" { return ("blk." + (stratum ↦ string)) + ".attn_q.weight" }
    if family ≡ "model.layers.self_attn.k_proj" { return ("blk." + (stratum ↦ string)) + ".attn_k.weight" }
    if family ≡ "model.layers.self_attn.v_proj" { return ("blk." + (stratum ↦ string)) + ".attn_v.weight" }
    if family ≡ "model.layers.self_attn.o_proj" { return ("blk." + (stratum ↦ string)) + ".attn_output.weight" }
    if family ≡ "model.layers.post_attention_layernorm" { return ("blk." + (stratum ↦ string)) + ".ffn_norm.weight" }
    if family ≡ "model.layers.mlp.gate_proj" { return ("blk." + (stratum ↦ string)) + ".ffn_gate.weight" }
    if family ≡ "model.layers.mlp.up_proj" { return ("blk." + (stratum ↦ string)) + ".ffn_up.weight" }
    if family ≡ "model.layers.mlp.down_proj" { return ("blk." + (stratum ↦ string)) + ".ffn_down.weight" }
    panic "unknown canonical tensor name: " + family
}

fn live_kmajor_to_linear(tensor.NumericBlock t) → tensor.NumericBlock {
    const list<int> f ← t.shape
    if f.length() ≠ 2 {
        panic "linear weight must be rank 2"
    }
    const int k ← f.get(0) coalesce 1
    const int n ← f.get(1) coalesce 1
    var list<f32> out ← []
    var int i ← 0
    while i < k {
        var int j ← 0
        while j < n {
            out.append(t.data.get(j * k + i) coalesce (0.0 ∷ f32))
            j ← j + 1
        }
        i ← i + 1
    }
    return live_tensor(out, [k, n])
}

fn live_linear_family(string family) → bool {
    if family ≡ "lm_head" { return true }
    if live_ends(family, ".self_attn.q_proj") { return true }
    if live_ends(family, ".self_attn.k_proj") { return true }
    if live_ends(family, ".self_attn.v_proj") { return true }
    if live_ends(family, ".self_attn.o_proj") { return true }
    if live_ends(family, ".mlp.gate_proj") { return true }
    if live_ends(family, ".mlp.up_proj") { return true }
    if live_ends(family, ".mlp.down_proj") { return true }
    return false
}

fn live_load_one(string via, int total, gguf_manifest.GgufManifest m, string family, int stratum) → tensor.NumericBlock {
    const string gguf_name ← live_gguf_name(family, stratum)
    const tensor.NumericBlock stored ← live_materialize(via, total, m, gguf_name)
    if live_linear_family(family) {
        return live_kmajor_to_linear(stored)
    }
    return stored
}

fn live_lookup(string nomen, int stratum, tensor.NumericBlock embed, tensor.NumericBlock norm_s, list<list<tensor.NumericBlock>> strata) → tensor.NumericBlock ⇥ dense.DenseError {
    if nomen ≡ "model.embed_tokens" { return embed }
    if nomen ≡ "model.norm" { return norm_s }
    if stratum < 0 or stratum ≥ strata.length() {
        throw variant MissingTensor { message = "layer out of range: " + (stratum ↦ string) }
    }
    const int slot ← live_slot(nomen)
    if slot < 0 {
        throw variant MissingTensor { message = "unknown canonical tensor: " + nomen }
    }
    var list<tensor.NumericBlock> missing ← []
    const list<tensor.NumericBlock> row ← strata.get(stratum) coalesce missing
    if slot ≥ row.length() {
        throw variant MissingTensor { message = "layer slot missing: " + nomen }
    }
    const tensor.NumericBlock t ← row.get(slot) coalesce embed
    return t
}

fn live_indices(int n) → list<int> {
    var list<int> out ← []
    var int i ← 0
    while i < n {
        out.append(i)
        i ← i + 1
    }
    return out
}

fn live_first_divergence(list<int> observed, list<int> golden) → string {
    var int i ← 0
    const int n ← observed.length()
    const int g ← golden.length()
    const int lim ← if_int(n < g, n, g)
    while i < lim {
        const int a ← observed.get(i) coalesce -1
        const int b ← golden.get(i) coalesce -2
        if a ≠ b {
            return "index " + (i ↦ string) + ": observed " + (a ↦ string) + " vs golden " + (b ↦ string)
        }
        i ← i + 1
    }
    if n ≠ g {
        return "length " + (n ↦ string) + " vs golden " + (g ↦ string)
    }
    return "none"
}

fn live_token_match_count(list<int> observed, list<int> golden) → int {
    var int matches ← 0
    var int i ← 0
    const int lim ← if_int(observed.length() < golden.length(), observed.length(), golden.length())
    while i < lim {
        const int a ← observed.get(i) coalesce -1
        const int b ← golden.get(i) coalesce -2
        if a ≡ b { matches ← matches + 1 }
        i ← i + 1
    }
    return matches
}

fn live_requested(list<string> argv) → bool {
    var int i ← 1
    while i < argv.length() {
        const string arg ← argv.get(i) coalesce ""
        if arg ≡ "live" { return true }
        i ← i + 1
    }
    return false
}

fn live_build_tokenizer(gguf_manifest.GgufManifest m) → tokenizator.Tokenizer {
    do {
        return tokenizator.build(m)
    }
    catch err {
        panic "G3 tokenizer tables failed: " + err.message
    }
}

fn live_tokenize(tokenizator.Tokenizer tok, string prompt) → list<int> {
    do {
        return tokenizator.tokenize(tok, prompt)
    }
    catch err {
        panic "G3 tokenize failed: " + err.message
    }
}

# Generated ids → decoded text through the admitted tokenizer (`tokenizator.decode`).
# A typed TokenizerError fails closed — no placeholder or partial text.
# Straight-line catch arm for the BD-3 stepper constraint.
fn live_decode(tokenizator.Tokenizer tok, list<int> tokens) → string {
    do {
        return tokenizator.decode(tok, tokens)
    }
    catch err {
        panic "G3 decode failed: " + err.message
    }
}

# The live stop policy: default eog_stop; --ignore-eos runs to the
# --max-tokens ceiling (the 16-token golden's stop).
fn live_stop_policy(bool ignore_eos) → decoder.StopPolicy {
    if ignore_eos { return decoder.ignore_eos() }
    return decoder.eog_stop()
}

fn inspect_model(string path, string sha) → gguf_manifest.GgufManifest {
    const int total ← live_file_size(path)
    if total ≠ model_file_size_bytes() {
        panic "model byte length mismatch: observed=" + (total ↦ string) + " expected=" + (model_file_size_bytes() ↦ string)
    }
    const int data_offset ← pinned_data_offset()
    const bytes prefix_bytes ← live_read_range(path, 0, data_offset)
    if prefix_bytes.length() ≠ data_offset {
        panic "table-prefix read was short"
    }
    const value prefix_valor ← prefix_bytes ↦ value
    const list<int> prefix ← prefix_valor ↦ list<int>
    const artifact.ContentIdentity identitas ← artifact.ContentIdentity {
        algorithm = "sha-256",
        digest = sha,
        length = total
    }
    var gguf_manifest.GgufManifest admitted ← empty_manifest()
    do {
        admitted ← gguf_manifest.inspect(
            (int initium, int longitudo) → bytes ⇥ gguf_manifest.GgufManifestError ∴ live_prefix_range(prefix, initium, longitudo),
            total,
            identitas
        )
    }
    catch err {
        panic "manifest admission failed: " + err.message
    }
    return admitted
}

fn load_resident_weights(string path, gguf_manifest.GgufManifest admitted) → ResidentModel {
    const int total ← live_file_size(path)
    const tokenizator.Tokenizer tok ← live_build_tokenizer(admitted)
    const list<int> eog_ids ← tokenizator.artifact_eog(tok)
    var tensor.NumericBlock embed ← tensor.default()
    var tensor.NumericBlock norm_s ← tensor.default()
    embed ← live_load_one(path, total, admitted, "model.embed_tokens", 0)
    norm_s ← live_load_one(path, total, admitted, "model.norm", 0)

    const list<string> families ← [
        "model.layers.input_layernorm",
        "model.layers.self_attn.q_proj",
        "model.layers.self_attn.k_proj",
        "model.layers.self_attn.v_proj",
        "model.layers.self_attn.o_proj",
        "model.layers.post_attention_layernorm",
        "model.layers.mlp.gate_proj",
        "model.layers.mlp.up_proj",
        "model.layers.mlp.down_proj"
    ]
    var list<list<tensor.NumericBlock>> strata ← []
    var int stratum ← 0
    while stratum < 32 {
        var list<tensor.NumericBlock> row ← []
        var int f ← 0
        while f < families.length() {
            row.append(live_load_one(path, total, admitted, families.get(f) coalesce "", stratum))
            f ← f + 1
        }
        strata.append(row)
        stderr_write("inferentia: loaded layer " + (stratum ↦ string) + "\n")
        stratum ← stratum + 1
    }

    var rope.RopeConfig rope_cfg ← rope.default()
    do {
        rope_cfg ← rope.construct_rope_config(100000.0 ∷ f32, 1.0 ∷ f32, rope.consecutive_policy())
    }
    catch err {
        panic "rope config failed: " + err.message
    }

    const dense.DenseConfig architecture ← dense.DenseConfig {
        layers = 32,
        heads = 15,
        kv_heads = 5,
        head_dim = 64,
        hidden_dim = 960,
        vocab = model_vocab_size(),
        tied = true
    }

    var structure.KVStructure kv_structure ← structure.default_kv_structure()
    do {
        const structure.LayerSet set ← structure.construct_layer_set(live_indices(32), structure.dense_structure(), 5, 64)
        var list<structure.LayerSet> sets ← []
        sets.append(set)
        kv_structure ← structure.construct_kv_structure(
            sets,
            structure.kv_dtype_f32(),
            structure.kv_dtype_f32(),
            structure.v_layout_transposed(),
            structure.sharing_gqa(),
            structure.attention_classic(),
            15,
            8192,
            8192
        )
    }
    catch err {
        panic "kv structure failed: " + err.message
    }

    const dense_gen.DenseEngine engine ← dense_gen.construct_dense_engine(architecture, 0.00001 ∷ f32, 0.125 ∷ f32, 64, rope_cfg)
    return ResidentModel {
        ready = true,
        engine = engine,
        embed = embed,
        norm_s = norm_s,
        strata = strata,
        structure = kv_structure,
        manifest = admitted,
        tokenizer = tok,
        eog_ids = eog_ids
    }
}

# Digest gate for serve admission (G1-U9): the refusal diagnostic when the
# admitted digest does not match the operator-supplied --expected-digest,
# null when admission proceeds. An empty expected means unset — serve exists
# to load arbitrary models, so an unset flag keeps today's behavior. Pure so
# the serve rows can feed digests as inputs.
fn check_expected_digest(string admitted, string expected) → string ∪ null {
    if expected ≡ "" {
        return null
    }
    if admitted ≡ expected {
        return null
    }
    return "model digest " + admitted + " does not match --expected-digest " + expected
}

# Materialization re-verify (G1-U9): the file is re-digested at load time,
# after admission, so a swap between admit and load cannot serve swapped
# weights. The refusal covers the admit → load TOCTOU (materialized ≠
# admitted) and the --expected-digest pin carried from serve; null lets
# load_resident_weights read. Pure so the rows feed digests as inputs.
fn check_materialized_digest(string admitted, string materialized, string expected) → string ∪ null {
    if materialized ≠ admitted {
        return "model changed between admission and materialization: admitted=" + admitted + " materialized=" + materialized
    }
    if expected ≠ "" and materialized ≠ expected {
        return "materialized digest " + materialized + " does not match --expected-digest " + expected
    }
    return null
}

# Admit → load TOCTOU closure (G1-U9): the admitted manifest was inspected
# from the bytes read at admission time, so before load_resident_weights
# reads the file again, re-digest it and require equality with the admitted
# sha (and with --expected-digest when set). A swapped or unreadable file
# throws BadCapsule, which serve routes into the failed state — the load
# never proceeds and swapped weights are never served.
fn load_resident_model(string path, string sha, string expected_digest) → ResidentModel ⇥ gguf.GgufError {
    const gguf_manifest.GgufManifest admitted ← inspect_model(path, sha)
    var string materialized ← ""
    do {
        materialized ← host_digestio(path)
    }
    catch err {
        throw variant BadCapsule { message = err }
    }
    const string ∪ null refusal ← check_materialized_digest(sha, materialized, expected_digest)
    if refusal not is null {
        throw variant BadCapsule { message = refusal coalesce "" }
    }
    return load_resident_weights(path, admitted)
}

fn run_generate(GenerateConfig cfg, list<int> ids, ResidentModel model, decoder.StopPolicy stop) → list<int> ⇥ config.GenerationError {
    const config.GenerationConfig g ← to_generation_config(cfg, model.eog_ids)
    var list<kv.KVCache> layers ← []
    if model.ready {
        layers ← fresh_resident_caches(model)
    }
    return dense_gen.generate_dense_with_stop(
        g,
        ids,
        model.engine,
        (string n, int s) → tensor.NumericBlock ⇥ dense.DenseError ∴ live_lookup(n, s, model.embed, model.norm_s, model.strata),
        layers,
        decode.fresh_cancellation(),
        stop
    )
}

fn live_run(ServeConfig serve_config) → void {
    stdout_write("inferentia live: admit + G3 tokenizer + generate_dense\n")
    stdout_write("model.path=" + serve_config.model + "\n")

    var string sha ← ""
    do {
        sha ← admit_model(serve_config.model)
    }
    catch err {
        panic "admit failed: " + err.message
    }
    stdout_write("admit.sha256=" + sha + "\n")
    if sha ≠ pinned_digest() {
        panic "admit digest mismatch: observed=" + sha + " expected=" + pinned_digest()
    }

    const int total ← live_file_size(serve_config.model)
    stdout_write("model.bytes=" + (total ↦ string) + "\n")

    const gguf_manifest.GgufManifest admitted ← inspect_model(serve_config.model, sha)
    stdout_write("manifest.data_offset=" + (admitted.data_start ↦ string) + "\n")

    const tokenizator.Tokenizer tok ← live_build_tokenizer(admitted)
    stdout_write("tokenizer.vocab=" + (tok.multitudo ↦ string) + "\n")

    const string prompt_text ← effective_prompt(serve_config)
    const list<int> prompt_ids ← live_tokenize(tok, prompt_text)
    stdout_write("prompt.ids=" + live_ids_text(prompt_ids) + "\n")
    if prompt_text ≡ frozen_prompt_text() {
        stdout_write("prompt.golden=" + live_ids_text(frozen_prompt_ids()) + "\n")
        if live_first_divergence(prompt_ids, frozen_prompt_ids()) ≠ "none" {
            panic "G3 tokenize diverged from pinned P10: " + live_first_divergence(prompt_ids, frozen_prompt_ids())
        }
    }

    const ResidentModel model ← load_resident_weights(serve_config.model, admitted)
    const list<kv.KVCache> layers ← fresh_resident_caches(model)
    stdout_write("cache.layers=" + (layers.length() ↦ string) + "\n")

    var config.GenerationConfig gen ← config.default()
    do {
        gen ← config.construct_generation(8192, effective_max_prompt(serve_config), serve_config.max_tokens, 1, 0.0 ∷ f32, 0, 1.0 ∷ f32, 0.0 ∷ f32, 1.0 ∷ f32, model.eog_ids)
    }
    catch err {
        panic "generation config failed: " + err.message
    }

    # Stop policy: default eog_stop; --ignore-eos keeps generating to the
    # --max-tokens ceiling. Selected outside the cape below (BD-3).
    const decoder.StopPolicy stop ← live_stop_policy(serve_config.ignore_eos)

    var list<int> generated ← []
    do {
        generated ← dense_gen.generate_dense_with_stop(
            gen,
            prompt_ids,
            model.engine,
            (string n, int s) → tensor.NumericBlock ⇥ dense.DenseError ∴ live_lookup(n, s, model.embed, model.norm_s, model.strata),
            layers,
            decode.fresh_cancellation(),
            stop
        )
    }
    catch err {
        panic "generate_dense failed: " + err.message
    }

    # The one-shot result surface: space-joined generated ids and the decoded
    # text (decode fails closed via live_decode).
    stdout_write("ids=" + live_ids_flat(generated) + "\n")
    const string text ← live_decode(tok, generated)
    stdout_write("text=" + text + "\n")

    # Oracle: only the frozen fixture has a golden. eog_stop compares the
    # [30, 2] continuation; --ignore-eos compares the 16-token U5 golden.
    var list<int> golden ← []
    var bool oracle ← false
    if prompt_text ≡ frozen_prompt_text() {
        oracle ← true
        if serve_config.ignore_eos {
            golden ← golden_tokens_16()
        } else {
            golden ← frozen_eog_continuation()
        }
    }
    if oracle {
        const string divergence ← live_first_divergence(generated, golden)
        const int matches ← live_token_match_count(generated, golden)
        stdout_write("observed=" + live_ids_text(generated) + "\n")
        stdout_write("golden=" + live_ids_text(golden) + "\n")
        stdout_write("observed.n=" + (generated.length() ↦ string) + "\n")
        stdout_write("token_match_count=" + (matches ↦ string) + "\n")
        stdout_write("first_divergence=" + divergence + "\n")
        if divergence ≡ "none" {
            stdout_write("LIVE: PASS\n")
        } else {
            stdout_write("LIVE: FAIL\n")
        }
    }
}

# ---------------------------------------------------------------------------
# Usage errors (D5): detected before any listen, non-zero exit.
# ---------------------------------------------------------------------------
fn usage_error(string message) → never {
    stderr_write("error: " + message)
    panic "usage error"
}

# ---------------------------------------------------------------------------
# CLI parsing (D1)
# ---------------------------------------------------------------------------

# Parse a base-10 integer; -1 when the text is not a valid integer.
# (-1 is never a legal value for any D1 numeric option.)
fn parse_int(string raw) → int {
    return raw ↦ int ⇥ -1
}

# The D1 `serve` syntax, printed on `--help`.
fn print_help() → void {
    stdout_write("Usage: inferentia <serve|live> [OPTIONS]\n")
    stdout_write("\n")
    stdout_write("Local-first GGUF inference server written in Faber\n")
    stdout_write("\n")
    stdout_write("Commands:\n")
    stdout_write("  serve                     Bind the HTTP server (U1–U4)\n")
    stdout_write("  live                      One-shot prompt in, decoded ids + text out\n")
    stdout_write("\n")
    stdout_write("Options:\n")
    stdout_write("  -m, --model <PATH>        Path to the GGUF model file (required)\n")
    stdout_write("      --prompt <TEXT>       Live one-shot prompt text (default: frozen fixture)\n")
    stdout_write("      --expected-digest <SHA256>  Serve: require the admitted sha256 to match (default: unset)\n")
    stdout_write("      --ignore-eos          Live: generate past EOG until --max-tokens\n")
    stdout_write("      --host <HOST>         Bind host (loopback only; default: 127.0.0.1)\n")
    stdout_write("      --port <PORT>         Bind port (default: 8080; 0 = ephemeral)\n")
    stdout_write("      --max-tokens <N>      Default output token ceiling (default: 32)\n")
    stdout_write("      --max-prompt <N>      Prompt-token admission bound (default: model limit)\n")
    stdout_write("      --context <N>         Session context ceiling (default: model limit)\n")
    stdout_write("      --seed <N>            Deterministic seed (default: 1)\n")
    stdout_write("      --log-level <LEVEL>   stderr verbosity: info|warn|error (default: info)\n")
    stdout_write("  -h, --help                Print help\n")
    stdout_write("      --version             Print version\n")
}

# Parse argv (program name included at index 0) into a ServeConfig.
# Every usage error exits before returning.
fn parse_cli(list<string> argv) → ServeConfig {
    var ServeConfig config ← ServeConfig { model = "", host = "127.0.0.1", port = 8080, max_tokens = 32, max_prompt = 0, context = 0, seed = 1, log_level = "info", prompt = "", expected_digest = "", ignore_eos = false }
    var string subcommand ← ""
    var int i ← 1

    while i < argv.length() {
        const string arg ← argv.get(i) coalesce ""
        if arg ≡ "--help" or arg ≡ "-h" {
            print_help()
            panic "help requested"
        }
        elif arg ≡ "--version" {
            stdout_write("inferentia 0.1.0\n")
            panic "version requested"
        }
        elif arg ≡ "--model" or arg ≡ "-m" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --model")
            config.model ← argv.get(i) coalesce ""
        }
        elif arg ≡ "--host" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --host")
            config.host ← argv.get(i) coalesce ""
        }
        elif arg ≡ "--port" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --port")
            const string raw ← argv.get(i) coalesce ""
            const int port ← parse_int(raw)
            if port < 0 or port > 65535 then usage_error("invalid port '" + raw + "' (expected 0..=65535)")
            config.port ← port
        }
        elif arg ≡ "--max-tokens" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --max-tokens")
            const string raw ← argv.get(i) coalesce ""
            const int value ← parse_int(raw)
            if value < 1 then usage_error("invalid max-tokens '" + raw + "' (expected >= 1)")
            config.max_tokens ← value
        }
        elif arg ≡ "--max-prompt" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --max-prompt")
            const string raw ← argv.get(i) coalesce ""
            const int value ← parse_int(raw)
            if value < 1 then usage_error("invalid max-prompt '" + raw + "' (expected >= 1)")
            config.max_prompt ← value
        }
        elif arg ≡ "--context" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --context")
            const string raw ← argv.get(i) coalesce ""
            const int value ← parse_int(raw)
            if value < 1 then usage_error("invalid context '" + raw + "' (expected >= 1)")
            config.context ← value
        }
        elif arg ≡ "--seed" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --seed")
            const string raw ← argv.get(i) coalesce ""
            const int value ← parse_int(raw)
            if value < 1 then usage_error("invalid seed '" + raw + "' (expected >= 1)")
            config.seed ← value
        }
        elif arg ≡ "--log-level" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --log-level")
            const string raw ← argv.get(i) coalesce ""
            if (raw ≡ "info") or (raw ≡ "warn") or (raw ≡ "error") {
                config.log_level ← raw
            } else {
                usage_error("invalid log-level '" + raw + "' (expected info|warn|error)")
            }
        }
        elif arg ≡ "--expected-digest" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --expected-digest")
            config.expected_digest ← argv.get(i) coalesce ""
        }
        elif arg ≡ "--prompt" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --prompt")
            const string raw ← argv.get(i) coalesce ""
            if raw ≡ "" then usage_error("invalid prompt '' (expected non-empty text)")
            config.prompt ← raw
        }
        elif arg ≡ "--ignore-eos" {
            config.ignore_eos ← true
        }
        elif arg.starts_with("-") and arg.length() > 1 {
            usage_error("unknown option '" + arg + "'")
        }
        else {
            if subcommand ≡ "" {
                subcommand ← arg
            } else {
                usage_error("unexpected operand '" + arg + "'")
            }
        }
        i ← i + 1
    }

    if subcommand ≡ "" then usage_error("missing subcommand 'serve' or 'live'")
    if subcommand ≡ "serve" or subcommand ≡ "live" {
        # serve: HTTP (U1–U4). live: one-shot generate_dense (I-live).
    } else {
        usage_error("unknown subcommand '" + subcommand + "'")
    }
    if config.model ≡ "" then usage_error("missing required option --model")

    return config
}

# ---------------------------------------------------------------------------
# Server loop + health lifecycle (U1 listener, U2 admission + states)
# ---------------------------------------------------------------------------

# The /health body per D3. The model identity on ready carries the verified
# whole-file SHA-256 (the only identity fact the BD-2 admit route returns) and
# the configured path; on failed it carries the typed cause. Every string
# value is JSON-escaped so a configured path or a typed error can never
# produce invalid JSON.
# Note: the D3 `pid` field is not served — the toolchain has no process-
# identity call form (empty-opener routes fail codegen; recorded gap).
fn health_body(ServerState st) → string {
    if st.state ≡ "starting" {
        return "{\"state\":\"starting\",\"model\":null}"
    }
    if st.state ≡ "failed" {
        return "{\"state\":\"failed\",\"model\":{\"error\":\"" + json_escape(st.error_text) + "\"}}"
    }
    return "{\"state\":\"ready\",\"model\":{\"sha256\":\"" + json_escape(st.sha256) + "\",\"path\":\"" + json_escape(st.model_path) + "\"}}"
}

# ---------------------------------------------------------------------------
# U3 — /model endpoint
#
# The pinned-row identity facts (i1-discovery §2.1 identity table; D3 schema).
# `sha256` is the one runtime fact — from the BD-2 admit route, held in
# ServerState. Every other field is a documented constant for the pinned
# SmolLM2-360M-Instruct-Q4_K_M row; `max_output_tokens` is the server default
# (D2 precedence — the configured `--max-tokens` value, not a per-request
# value). Field order is the D3 order: name, architecture, quantization,
# file_size_bytes, sha256, context_length, vocab_size, max_output_tokens,
# backend.
# ---------------------------------------------------------------------------
fn model_identity_name() → string {
    return "SmolLM2-360M-Instruct-Q4_K_M"
}

fn model_architecture() → string {
    return "llama"
}

fn model_quantization() → string {
    return "q4_k_m"
}

fn model_file_size_bytes() → int {
    return 270590880
}

fn model_vocab_size() → int {
    return 49152
}

fn model_backend() → string {
    return "cpu"
}

# The /model response body (D3 exact schema). `sha256` is JSON-escaped for
# consistency with the other identity bodies (hex, so normally a no-op).
fn model_body(ServerState st, int max_output_tokens) → string {
    return "{\"name\":\"" + model_identity_name() + "\",\"architecture\":\"" + model_architecture() + "\",\"quantization\":\"" + model_quantization() + "\",\"file_size_bytes\":" + (model_file_size_bytes() ↦ string) + ",\"sha256\":\"" + json_escape(st.sha256) + "\",\"context_length\":" + (model_context_limit() ↦ string) + ",\"vocab_size\":" + (model_vocab_size() ↦ string) + ",\"max_output_tokens\":" + (max_output_tokens ↦ string) + ",\"backend\":\"" + model_backend() + "\"}"
}

# D3: 503 before ready / on failure carries the minimal state body
# (`{"state":"starting"|"failed"}` — the typed cause is served by /health).
fn model_unready_body(ServerState st) → string {
    return "{\"state\":\"" + st.state + "\"}"
}

# Handle a /model request (U3). The pipeline: method gate → state gate →
# response assembly. GET is the only method (D3); any other method is a
# reject. Before ready the endpoint answers 503 with the state; on ready it
# answers 200 with the exact pinned identity body.
fn handle_model(server.Incoming incoming, ServerState st, ServeConfig config) → void {
    if incoming.req.method ≠ "GET" {
        reply_json(incoming, 400, error_body("method must be GET for /model"))
        return
    }
    if st.state ≠ "ready" {
        reply_json(incoming, 503, model_unready_body(st))
        return
    }
    reply_json(incoming, 200, model_body(st, config.max_tokens))
}

# Handle a /generate request (U4). The pipeline: method gate → state gate →
# cancellation checkpoint → body read → minimal JSON parse → cancellation
# checkpoint → encode → engine generate (prefill + greedy decode with the
# admitted tokenizer EOG stop set and the max_tokens budget) → response assembly.
# Domain validation (the gradus reject rows) is enforced by the engine with
# typed causes; this unit maps them to 400/500.
fn handle_generate(server.Incoming incoming, value raw, ServerState st, ServeConfig config, ResidentModel model) → void {
    # Method gate: /generate is POST (D3).
    if incoming.req.method ≠ "POST" {
        reply_json(incoming, 400, error_body("method must be POST for /generate"))
        return
    }
    # State gate: 503 before ready (D3).
    if st.state ≠ "ready" {
        reply_json(incoming, 503, state_body(st))
        return
    }
    # Cancellation checkpoint (D6 seam; no signal source is wired yet — the
    # native host has no processus signal route, a recorded U6 gap).
    if st.cancelled {
        reply_json(incoming, 503, error_body("generation cancelled (shutdown)"))
        return
    }
    # Body from the raw accept valor (Incoming.req.body drops octeti in
    # server._body_text). `value ↦ bytes` extracts the provider octeti.
    const string body ← request_body_from_raw(raw)
    if body ≡ body_read_gap_marker() {
        reply_json(incoming, 500, error_body("request body unavailable: octeti→text decode failed"))
        return
    }
    # Minimal product JSON parse (D3).
    const GenerateRequest parsed ← json_parse_generate_body(body)
    if not parsed.ok {
        reply_json(incoming, 400, error_body(parsed.error))
        return
    }
    if st.cancelled {
        reply_json(incoming, 503, error_body("generation cancelled (shutdown)"))
        return
    }
    # Encode: text → token ids through the admitted model's real G3
    # tokenizer (the tables loaded with the resident weights).
    const EncodeResult enc ← encode_prompt(model.tokenizer, parsed.prompt)
    if not enc.ok {
        reply_json(incoming, 400, error_body(enc.error))
        return
    }
    const GenerateConfig cfg ← build_generate_config(parsed, config)
    do {
        const list<int> tokens ← run_generate(cfg, enc.ids, model, decoder.eog_stop())
        # Cancellation checkpoint after decode (D6 seam).
        if st.cancelled {
            reply_json(incoming, 503, error_body("generation cancelled (shutdown)"))
        } else {
            # Detokenize before any body assembly or stream open: a typed
            # decode failure fails closed instead of emitting a partial body.
            const DecodeResult dec ← tokens_text(model.tokenizer, tokens)
            if not dec.ok {
                reply_json(incoming, classify_generate_error(dec.error), error_body(dec.error))
            } elif wants_sse(incoming) {
                send_generate_stream(incoming, st, dec.text, tokens, enc.ids, cfg.maxima_verborum)
            } else {
                reply_json(incoming, 200, generate_response_body(st, dec.text, tokens, enc.ids, cfg.maxima_verborum))
            }
        }
    }
    catch err {
        const string cause ← err.message
        const int code ← classify_generate_error(cause)
        reply_json(incoming, code, error_body(cause))
    }
}

# Respond to one request carrier. /health is always 200 once the listener is
# up; /generate is the U4 endpoint; any other path is 404 (D3).
fn handle_request(value request, ServerState st, ServeConfig config, ResidentModel model) → void {
    if request is map<string, value> {
        const server.Incoming incoming ← server.incoming_of(request)
        const string path ← incoming.req.path
        if path ≡ "/health" {
            reply_json(incoming, 200, health_body(st))
        } elif path ≡ "/model" {
            handle_model(incoming, st, config)
        } elif path ≡ "/generate" {
            handle_generate(incoming, request, st, config, model)
        } else {
            reply_json(incoming, 404, "not found")
        }
    }
}

# Accept-loop step: keep serving unless the listener was stopped or the
# accept was cancelled; log other request-level rejects (oversize body,
# malformed request) and continue. A stopped listener ends the loop (D6).
fn accept_loop_step(bool serving, string err) → bool {
    const bool cancelled_hit ← err.contains("E_CANCELLED")
    const bool stopped_hit ← err.contains("listener is stopped")
    if cancelled_hit or stopped_hit {
        return false
    }
    stderr_write("inferentia: request dropped at accept: " + err + "\n")
    return serving
}

fn serve(ServeConfig config) → void {
    # U2 admission ordering: bind first, then admit BEFORE any allocation.
    # admit computes the whole-file digest and pins the pinned-row structure
    # (BD-2 gate) — gguf.admit receives the digest but never compares it
    # against a pin. Digest verification lives in the live pin (live_run),
    # the optional --expected-digest flag checked here at admission, and the
    # materialization re-verify in load_resident_model (admit → load TOCTOU).
    # Weight materialization is out of this path: never forward/generate.
    const server.Listener listener ← server.bind(config.port)
    stderr_write("inferentia: listening on 127.0.0.1:" + (config.port ↦ string) + "\n")

    var ServerState state ← new_state(config.model)
    do {
        const string sha ← admit_model(state.model_path)
        const string ∪ null digest_refusal ← check_expected_digest(sha, config.expected_digest)
        if digest_refusal not is null {
            throw variant BadCapsule { message = digest_refusal coalesce "" }
        }
        state ← admitted(state, sha)
        stderr_write("inferentia: model admitted (sha256 " + sha + ")\n")
    }
    catch err {
        const string cause ← err.message
        state ← failed(state, cause)
        stderr_write("inferentia: admission failed: " + cause + "\n")
    }

    # U4 generation readiness: load the dense weights exactly once and prove
    # generate_dense_with_stop (eog_stop) can decode before serving. Every
    # /generate reuses the resident model (fresh KV caches per request). A
    # failed load or warm-up is an admission/load failure (D5 → exit 2):
    # load_resident_model re-verifies the digest at materialization, so a
    # file swapped between admit and load throws into the failed state here.
    var ResidentModel resident ← empty_resident()
    if state.state ≡ "ready" {
        do {
            resident ← load_resident_model(state.model_path, state.sha256, config.expected_digest)
        }
        catch err {
            state ← failed(state, err.message)
            stderr_write("inferentia: model load failed: " + err.message + "\n")
        }
    }
    if state.state ≡ "ready" {
        do {
            const GenerateConfig warmup_cfg ← GenerateConfig {
                contextus = model_context_limit(),
                magna_promptus = effective_max_prompt(config),
                maxima_verborum = 1,
                semen = config.seed,
                temperatura = 0.0,
                top_k = 0,
                top_p = 1.0,
                min_p = 0.0,
                poena_repetitionis = 1.0
            }
            const list<int> warmup_tokens ← run_generate(warmup_cfg, frozen_prompt_ids(), resident, decoder.eog_stop())
            const int n ← warmup_tokens.length()
            if n < 1 {
                state ← failed(state, "generation readiness: warm-up produced no tokens")
                stderr_write("inferentia: generation readiness failed: warm-up produced no tokens\n")
            } else {
                stderr_write("inferentia: model loaded once (resident) — generation ready\n")
            }
        }
        catch err {
            const string cause ← err.message
            state ← failed(state, "generation readiness failed: " + cause)
            stderr_write("inferentia: generation readiness failed: " + cause + "\n")
        }
    }

    var bool serving ← true
    while serving {
        do {
            const value request ← server.accept(listener.handle)
            handle_request(request, state, config, resident)
        }
        catch err {
            # A request-level reject (oversize body, malformed request) must
            # not end the serve loop; only a stopped/cancelled listener does.
            # The decision lives in a helper: the MIR stepper (`faber test`)
            # cannot lower a conditional inside a `cape` block that wraps a
            # local call into a host route (recorded toolchain limitation).
            serving ← accept_loop_step(serving, err ↦ string ⇥ "accept error")
        }
    }

    # Loop-end shutdown path (reachable when the listener stops / accept is
    # cancelled). The D5 exit-code decision maps failed admission to exit 2
    # and successful admission / clean shutdown to exit 0; the code is
    # DELIVERED to the process via the processus:exi primitive (exit_with).
    # The loop-end trigger (SIGTERM → http:stop) is the recorded U6 signal
    # gap: with no signal route wired, SIGTERM kills the process by signal
    # (observed exit 143) and this loop-end path is not reached. The
    # executable exit-code proof for the harness paths runs under
    # tests/admission-gate/ and tests/process-exit/.
    stderr_write("inferentia: shutting down (exit code " + (exit_code_for(state.state) ↦ string) + ")\n")
    exit_with(exit_code_for(state.state))
}

# ---------------------------------------------------------------------------
# Entry
# ---------------------------------------------------------------------------
main args argv {
    const ServeConfig config ← parse_cli(argv)
    if live_requested(argv) {
        live_run(config)
    } else {
        serve(config)
    }
}

# ---------------------------------------------------------------------------
# Tests (pure parse + lifecycle logic; process-exit statuses are proven by the
# product binary under tests/process-exit/ — blocked on the scoped native-host
# processus:exi runtime fix — and by the admission-gate harness under
# tests/admission-gate/; the provider-touching admission path is executed by
# the admission-gate harness and proven by the in-tree BD-2 probe)
# ---------------------------------------------------------------------------
describe "serve cli parse" tag "inferentia" {
    test "documented constants apply when no server flags are given" {
        const ServeConfig cfg ← parse_cli(["inferentia", "serve", "--model", "/tmp/model.gguf"])
        assert cfg.host ≡ "127.0.0.1"
        assert cfg.port ≡ 8080
        assert cfg.max_tokens ≡ 32
        assert cfg.max_prompt ≡ 0
        assert cfg.seed ≡ 1
        assert cfg.log_level ≡ "info"
        assert cfg.model ≡ "/tmp/model.gguf"
    }
    test "server flags override documented constants" {
        const ServeConfig cfg ← parse_cli(["inferentia", "serve", "--model", "/tmp/model.gguf", "--port", "9090", "--max-tokens", "16", "--max-prompt", "2048", "--seed", "7", "--host", "127.0.0.1", "--log-level", "warn"])
        assert cfg.port ≡ 9090
        assert cfg.max_tokens ≡ 16
        assert cfg.max_prompt ≡ 2048
        assert cfg.seed ≡ 7
        assert cfg.host ≡ "127.0.0.1"
        assert cfg.log_level ≡ "warn"
    }
    test "port zero is ephemeral" {
        const ServeConfig cfg ← parse_cli(["inferentia", "serve", "--model", "/tmp/model.gguf", "--port", "0"])
        assert cfg.port ≡ 0
    }
    test "short model flag binds the same option" {
        const ServeConfig cfg ← parse_cli(["inferentia", "serve", "-m", "/tmp/model.gguf"])
        assert cfg.model ≡ "/tmp/model.gguf"
    }
    test "live subcommand accepts the model path" {
        const ServeConfig cfg ← parse_cli(["inferentia", "live", "--model", "/tmp/model.gguf"])
        assert cfg.model ≡ "/tmp/model.gguf"
        assert live_requested(["inferentia", "live", "--model", "/tmp/model.gguf"])
        assert not live_requested(["inferentia", "serve", "--model", "/tmp/model.gguf"])
    }
    test "context is unset until a flag provides it" {
        const ServeConfig cfg ← parse_cli(["inferentia", "serve", "--model", "/tmp/model.gguf"])
        assert cfg.context ≡ 0
        const ServeConfig cfg2 ← parse_cli(["inferentia", "serve", "--model", "/tmp/model.gguf", "--context", "4096"])
        assert cfg2.context ≡ 4096
    }
    test "max prompt is unset until a flag provides it" {
        const ServeConfig cfg ← parse_cli(["inferentia", "serve", "--model", "/tmp/model.gguf"])
        assert cfg.max_prompt ≡ 0
        const ServeConfig cfg2 ← parse_cli(["inferentia", "serve", "--model", "/tmp/model.gguf", "--max-prompt", "2048"])
        assert cfg2.max_prompt ≡ 2048
    }
    test "live prompt flag binds text; ignore-eos defaults off" {
        const ServeConfig cfg ← parse_cli(["inferentia", "live", "--model", "/tmp/model.gguf", "--prompt", "hello world"])
        assert cfg.prompt ≡ "hello world"
        assert not cfg.ignore_eos
        assert effective_prompt(cfg) ≡ "hello world"
    }
    test "live defaults select the frozen fixture prompt" {
        const ServeConfig cfg ← parse_cli(["inferentia", "live", "--model", "/tmp/model.gguf"])
        assert cfg.prompt ≡ ""
        assert not cfg.ignore_eos
        assert effective_prompt(cfg) ≡ frozen_prompt_text()
    }
    test "ignore-eos flag parses on" {
        const ServeConfig cfg ← parse_cli(["inferentia", "live", "--model", "/tmp/model.gguf", "--ignore-eos"])
        assert cfg.ignore_eos
        assert effective_prompt(cfg) ≡ frozen_prompt_text()
    }
}
describe "health lifecycle" tag "inferentia" {
    test "state starts starting before admission" {
        const ServerState st ← new_state("/models/x.gguf")
        assert st.state ≡ "starting"
        assert st.sha256 ≡ ""
        assert st.error_text ≡ ""
    }
    test "admission success transitions to ready with model identity" {
        const ServerState st ← admitted(new_state("/models/x.gguf"), "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2")
        assert st.state ≡ "ready"
        assert st.sha256 ≡ "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2"
        assert st.error_text ≡ ""
        assert st.model_path ≡ "/models/x.gguf"
    }
    test "admission failure transitions to failed with typed error" {
        const ServerState st ← failed(new_state("/missing.gguf"), "io error: No such file")
        assert st.state ≡ "failed"
        assert st.error_text ≡ "io error: No such file"
    }
    test "health body starting" {
        const ServerState st ← new_state("/models/x.gguf")
        assert health_body(st) ≡ "{\"state\":\"starting\",\"model\":null}"
    }
    test "health body ready carries model identity" {
        const ServerState st ← admitted(new_state("/models/x.gguf"), "2fa3f013")
        assert health_body(st) ≡ "{\"state\":\"ready\",\"model\":{\"sha256\":\"2fa3f013\",\"path\":\"/models/x.gguf\"}}"
    }
    test "health body failed carries typed cause" {
        const ServerState st ← failed(new_state("/missing.gguf"), "io error: No such file")
        assert health_body(st) ≡ "{\"state\":\"failed\",\"model\":{\"error\":\"io error: No such file\"}}"
    }
    test "json escape leaves plain text unchanged" {
        assert json_escape("plain text") ≡ "plain text"
    }
    test "json escape escapes quotes and backslashes backslash-first" {
        # The order matters: backslashes first, then quotes — the reverse
        # order would double the inserted backslashes and leave the quote
        # unescaped. `a"b\c` carries both characters.
        assert json_escape("a\"b\\c") ≡ "a\\\"b\\\\c"
    }
    test "json escape escapes control characters" {
        assert json_escape("line1\nline2\tend") ≡ "line1\\nline2\\tend"
    }
    test "health body ready escapes quotes and backslashes in the path" {
        const ServerState st ← admitted(new_state("/models/a\"b\\c.gguf"), "2fa3f013")
        assert health_body(st) ≡ "{\"state\":\"ready\",\"model\":{\"sha256\":\"2fa3f013\",\"path\":\"/models/a\\\"b\\\\c.gguf\"}}"
    }
    test "health body ready escapes control characters in the path" {
        const ServerState st ← admitted(new_state("/models/x\nline.gguf"), "2fa3f013")
        assert health_body(st) ≡ "{\"state\":\"ready\",\"model\":{\"sha256\":\"2fa3f013\",\"path\":\"/models/x\\nline.gguf\"}}"
    }
    test "health body failed escapes quotes and backslashes in the error" {
        const ServerState st ← failed(new_state("/missing.gguf"), "io error: \"boom\" at \\tmp\\x")
        assert health_body(st) ≡ "{\"state\":\"failed\",\"model\":{\"error\":\"io error: \\\"boom\\\" at \\\\tmp\\\\x\"}}"
    }
    test "exit code decision maps failed to 2" {
        assert exit_code_for("failed") ≡ 2
        assert exit_code_for("ready") ≡ 0
        assert exit_code_for("starting") ≡ 0
    }
}
describe "generate request JSON parse" tag "inferentia" {
    test "frozen fixture request parses to the pinned fields" {
        const GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"The quick brown fox jumps over the lazy dog\",\"max_tokens\":16,\"temperature\":0.0,\"top_k\":0,\"top_p\":1.0,\"min_p\":0.0,\"repeat_penalty\":1.0,\"seed\":1}")
        assert req.ok
        assert req.prompt ≡ "The quick brown fox jumps over the lazy dog"
        assert req.has_prompt
        assert req.has_max_tokens
        assert req.max_tokens ≡ 16
        assert req.has_temperature
        assert req.temperature ≡ 0.0
        assert (req.has_top_k) and (req.top_k ≡ 0)
        assert (req.has_top_p) and (req.top_p ≡ 1.0)
        assert (req.has_min_p) and (req.min_p ≡ 0.0)
        assert (req.has_repeat_penalty) and (req.repeat_penalty ≡ 1.0)
        assert (req.has_seed) and (req.seed ≡ 1)
    }
    test "minimal request parses with optional fields absent" {
        const GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"The quick brown fox jumps over the lazy dog\"}")
        assert req.ok
        assert req.prompt ≡ "The quick brown fox jumps over the lazy dog"
        assert not req.has_max_tokens
        assert not req.has_max_prompt
        assert not req.has_temperature
        assert not req.has_seed
    }
    test "unknown field is an imperium_admissum reject row" {
        const GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"hi\",\"bogus\":1}")
        assert not req.ok
        assert req.error.contains("unknown field 'bogus'")
        assert req.error.contains("imperium_admissum")
    }
    test "empty prompt is rejected" {
        const GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"\"}")
        assert not req.ok
        assert req.error.contains("must not be empty")
    }
    test "missing prompt is rejected" {
        const GenerateRequest req ← json_parse_generate_body("{\"max_tokens\":4}")
        assert not req.ok
        assert req.error.contains("missing required field 'prompt'")
    }
    test "malformed JSON is rejected with a typed cause" {
        assert not (json_parse_generate_body("")).ok
        assert not (json_parse_generate_body("not json")).ok
        assert not (json_parse_generate_body("{\"prompt\":")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\"} trailing")).ok
        assert not (json_parse_generate_body("{\"prompt\" \"hi\"}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",}")).ok
    }
    test "wrong field types are rejected" {
        assert not (json_parse_generate_body("{\"prompt\":42}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"max_tokens\":16.5}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"max_tokens\":\"x\"}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"max_prompt\":\"x\"}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"seed\":true}")).ok
    }
    test "duplicate fields are rejected" {
        const GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"a\",\"prompt\":\"b\"}")
        assert not req.ok
        assert req.error.contains("duplicate field")
    }
    test "max_prompt body field parses and rejects bad shapes" {
        const GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"hi\",\"max_prompt\":128}")
        assert req.ok
        assert (req.has_max_prompt) and (req.max_prompt ≡ 128)
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"max_prompt\":1.5}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"max_prompt\":4,\"max_prompt\":8}")).ok
    }
    test "whitespace and integer-form floats are tolerated" {
        const GenerateRequest req ← json_parse_generate_body("  { \"prompt\" : \"hi\" , \"max_tokens\" : 4 , \"temperature\" : 1 }  ")
        assert req.ok
        assert req.prompt ≡ "hi"
        assert req.max_tokens ≡ 4
        assert (req.has_temperature) and (req.temperature ≡ 1.0)
    }
    test "escapes decode in string values" {
        const GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"a\\nb\\tc\\\"d\"}")
        assert req.ok
        assert req.prompt ≡ "a\nb\tc\"d"
    }
    test "unsupported unicode escape is rejected with a typed cause" {
        const GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"a\\u0041\"}")
        assert not req.ok
        assert req.error.contains("\\uXXXX escapes are not supported")
    }
}
describe "generate config precedence" tag "inferentia" {
    test "body overrides server flag overrides default" {
        const ServeConfig server ← ServeConfig { model = "/m.gguf", host = "127.0.0.1", port = 8080, max_tokens = 32, max_prompt = 0, context = 0, seed = 1, log_level = "info", prompt = "", expected_digest = "", ignore_eos = false }
        const GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"x\",\"max_tokens\":8,\"seed\":3}")
        const GenerateConfig cfg ← build_generate_config(req, server)
        assert cfg.contextus ≡ 8192
        assert cfg.maxima_verborum ≡ 8
        assert cfg.semen ≡ 3
        assert cfg.magna_promptus ≡ 8192
        assert cfg.temperatura ≡ 0.0
        assert cfg.top_k ≡ 0
        assert cfg.top_p ≡ 1.0
        assert cfg.min_p ≡ 0.0
        assert cfg.poena_repetitionis ≡ 1.0
    }
    test "absent body fields inherit the server flags" {
        const ServeConfig server ← ServeConfig { model = "/m.gguf", host = "127.0.0.1", port = 8080, max_tokens = 16, max_prompt = 1024, context = 4096, seed = 7, log_level = "info", prompt = "", expected_digest = "", ignore_eos = false }
        const GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"x\"}")
        const GenerateConfig cfg ← build_generate_config(req, server)
        assert cfg.contextus ≡ 4096
        assert cfg.maxima_verborum ≡ 16
        assert cfg.magna_promptus ≡ 1024
        assert cfg.semen ≡ 7
        assert cfg.temperatura ≡ 0.0
        assert cfg.top_p ≡ 1.0
        assert cfg.poena_repetitionis ≡ 1.0
    }
    test "body max_prompt overrides the server flag" {
        const ServeConfig server ← ServeConfig { model = "/m.gguf", host = "127.0.0.1", port = 8080, max_tokens = 16, max_prompt = 1024, context = 4096, seed = 7, log_level = "info", prompt = "", expected_digest = "", ignore_eos = false }
        const GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"x\",\"max_prompt\":256}")
        const GenerateConfig cfg ← build_generate_config(req, server)
        assert cfg.magna_promptus ≡ 256
    }
}
# Test fixture tokenizer: a minimal byte-level BPE table (ids 0..2, one
# merge "a b" → "ab") built through the same public table constructor the
# artifact path uses.
fn table_tokenizer() → tokenizator.Tokenizer {
    do {
        return tokenizator.build_tables([0, 1, 2], ["a", "b", "ab"], ["a b"], [])
    }
    catch err {
        panic "test tokenizer tables failed: " + err.message
    }
}

describe "prompt encode" tag "inferentia" {
    test "table-built tokenizer encodes through G3 tokenize" {
        const EncodeResult enc ← encode_prompt(table_tokenizer(), "ab")
        assert enc.ok
        const int n ← enc.ids.length()
        assert n ≡ 1
        const int first ← enc.ids.get(0) coalesce 0
        assert first ≡ 2
    }
    test "empty-table tokenizer fails closed with the typed cause" {
        const EncodeResult enc ← encode_prompt(empty_tokenizer(), "some other text")
        assert not enc.ok
        assert enc.error.contains("prompt encode failed")
    }
}
describe "generate error classification" tag "inferentia" {
    test "gradus reject-row causes map to 400" {
        assert classify_generate_error("maximum generated tokens must fit within the context") ≡ 400
        assert classify_generate_error("malformed generation config wire") ≡ 400
        assert classify_generate_error("prompt length does not fit context") ≡ 400
        assert classify_generate_error("needs at least one prompt token") ≡ 400
        assert classify_generate_error("seed must be at least one") ≡ 400
        assert classify_generate_error("temperature must be non-negative") ≡ 400
    }
    test "engine-side failures map to 500" {
        assert classify_generate_error("prefill failed: op mismatch") ≡ 500
        assert classify_generate_error("decode failed: layout") ≡ 500
        assert classify_generate_error("pinned model unavailable") ≡ 500
        assert classify_generate_error("") ≡ 500
    }
}

describe "generate response" tag "inferentia" {
    test "finish reason is length at the budget and eos below it" {
        assert finish_reason(16, 16) ≡ "length"
        assert finish_reason(5, 16) ≡ "eos"
        assert finish_reason(0, 1) ≡ "eos"
    }
    test "tokens text decodes through the tokenizer" {
        const DecodeResult joined ← tokens_text(table_tokenizer(), [0, 1])
        assert joined.ok
        assert joined.text ≡ "ab"
        const DecodeResult empty ← tokens_text(table_tokenizer(), [])
        assert empty.ok
        assert empty.text ≡ ""
    }
    test "out-of-range token id fails closed with the typed cause" {
        const DecodeResult dec ← tokens_text(table_tokenizer(), [7])
        assert not dec.ok
        assert dec.error.contains("token id outside the vocabulary range")
    }
    test "tokens json machine surface" {
        const list<int> tokens ← [30, 198, 198]
        assert tokens_json(tokens) ≡ "[30,198,198]"
        const list<int> empty ← []
        assert tokens_json(empty) ≡ "[]"
    }
    test "generate response body shape" {
        const ServerState st ← admitted(new_state("/models/x.gguf"), "2fa3f013")
        const list<int> tokens ← [2, 0, 1]
        const list<int> prompt_ids ← [504, 2365]
        const string body ← generate_response_body(st, "abab", tokens, prompt_ids, 16)
        assert body.contains("\"model\"")
        assert body.contains("\"text\":\"abab\"")
        assert body.contains("\"tokens\":[2,0,1]")
        assert body.contains("\"finish_reason\":\"eos\"")
        assert body.contains("\"usage\":{\"prompt_tokens\":2,\"completion_tokens\":3,\"total_tokens\":5}")
    }
    test "generate response body escapes decoded text" {
        const ServerState st ← admitted(new_state("/models/x.gguf"), "2fa3f013")
        const string body ← generate_response_body(st, "a\"b", [0], [1], 1)
        assert body.contains("\"text\":\"a\\\"b\"")
    }
    test "error body escapes embedded quotes" {
        const string body ← error_body("malformed generation config wire")
        assert body ≡ "{\"error\":\"malformed generation config wire\"}"
    }
    test "fixture EOG stop set is pinned to {0,2}" {
        # This is a fixture oracle only. Production generation receives its
        # set from the admitted tokenizer metadata in ResidentModel.
        const list<int> eog ← [0, 2]
        const int n ← eog.length()
        assert n ≡ 2
        const int first ← eog.get(0) coalesce -1
        const int second ← eog.get(1) coalesce -1
        assert (first ≡ 0) and (second ≡ 2)
    }
}
describe "model endpoint" tag "inferentia" {
    test "pinned identity constants match the discovery facts" {
        assert model_identity_name() ≡ "SmolLM2-360M-Instruct-Q4_K_M"
        assert model_architecture() ≡ "llama"
        assert model_quantization() ≡ "q4_k_m"
        assert model_file_size_bytes() ≡ 270590880
        assert model_vocab_size() ≡ 49152
        assert model_backend() ≡ "cpu"
        assert model_context_limit() ≡ 8192
    }
    test "model body matches the committed expected body at the server default" {
        # Exact D3 wire format (field order, no whitespace) — the same literal
        # committed as tests/model-gate/expected-model-body.json, which the
        # live curl proof diffs against.
        const ServerState st ← admitted(new_state("/Users/ianzepp/ai/models/SmolLM2-360M-Instruct-Q4_K_M.gguf"), "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2")
        assert model_body(st, 32) ≡ "{\"name\":\"SmolLM2-360M-Instruct-Q4_K_M\",\"architecture\":\"llama\",\"quantization\":\"q4_k_m\",\"file_size_bytes\":270590880,\"sha256\":\"2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2\",\"context_length\":8192,\"vocab_size\":49152,\"max_output_tokens\":32,\"backend\":\"cpu\"}"
    }
    test "model body reflects the configured max_output_tokens" {
        const ServerState st ← admitted(new_state("/m.gguf"), "2fa3f013")
        assert model_body(st, 16).contains("\"max_output_tokens\":16")
        assert model_body(st, 1).contains("\"max_output_tokens\":1")
    }
    test "model unready body carries the state" {
        assert model_unready_body(new_state("/m.gguf")) ≡ "{\"state\":\"starting\"}"
        const ServerState st ← failed(new_state("/m.gguf"), "io error: No such file")
        assert model_unready_body(st) ≡ "{\"state\":\"failed\"}"
    }
    test "model body escapes the admitted sha256" {
        # json_escape is applied to the sha256 (a no-op for hex, but the body
        # stays valid JSON under any future identity source).
        const ServerState st ← admitted(new_state("/m.gguf"), "a\"b")
        assert model_body(st, 32).contains("\"sha256\":\"a\\\"b\"")
    }
}
describe "http module" tag "inferentia" {
    test "server genera import from norma:http/server" {
        const server.Listener listener ← server.Listener { handle = 1 }
        const server.Incoming incoming ← server.Incoming {
            id = "http-1",
            connection = 2,
            req = httpreq.Request { method = "GET", path = "/health", query = "", body = "" }
        }
        assert listener.handle ≡ 1
        assert incoming.id ≡ "http-1"
        assert incoming.connection ≡ 2
        assert not wants_sse(incoming)
    }
    test "string valor body extracts as text" {
        assert request_body_text("{\"prompt\":\"hi\"}" ↦ value) ≡ "{\"prompt\":\"hi\"}"
    }
    test "octeti valor body extracts as UTF-8 text" {
        const bytes payload ← "{\"prompt\":\"hi\"}" ↦ bytes
        const value v ← payload ↦ value
        assert request_body_text(v) ≡ "{\"prompt\":\"hi\"}"
    }
    test "json headers carry content-type" {
        const headers.Headers head ← json_headers()
        const string ∪ null ct ← head.get("content-type")
        assert ct not is null
        assert (ct ↦ string) ≡ "application/json"
    }
    test "incoming_of splits stream query and wants sse" {
        var map<string, value> raw ← {}
        raw.put("id", "http-1" ↦ value)
        raw.put("connection", 1 ↦ value)
        raw.put("method", "POST" ↦ value)
        raw.put("path", "/generate?stream=1" ↦ value)
        raw.put("headers", [] ↦ value)
        raw.put("body", "" ↦ value)
        const server.Incoming incoming ← server.incoming_of(raw ↦ value)
        assert incoming.req.path ≡ "/generate"
        assert wants_sse(incoming)
    }
    test "accept text/event-stream wants sse" {
        var map<string, value> raw ← {}
        raw.put("id", "http-1" ↦ value)
        raw.put("connection", 1 ↦ value)
        raw.put("method", "POST" ↦ value)
        raw.put("path", "/generate" ↦ value)
        var map<string, value> row ← {}
        row.put("name", "Accept" ↦ value)
        row.put("value", "text/event-stream" ↦ value)
        var list<value> hdrs ← []
        hdrs.append(row ↦ value)
        raw.put("headers", hdrs ↦ value)
        raw.put("body", "" ↦ value)
        const server.Incoming incoming ← server.incoming_of(raw ↦ value)
        assert wants_sse(incoming)
    }
}
describe "serve expected digest" tag "inferentia" {
    test "unset flag keeps today's behavior: any admitted digest passes" {
        # Default unset (G1-U9 clause 1): serve exists to load arbitrary
        # models, so the admission gate returns null for every digest.
        const ServeConfig cfg ← parse_cli(["inferentia", "serve", "--model", "/tmp/model.gguf"])
        assert cfg.expected_digest ≡ ""
        assert check_expected_digest("2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2", cfg.expected_digest) is null
        assert check_expected_digest("0000f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2", cfg.expected_digest) is null
    }
    test "set flag binds from the cli" {
        const ServeConfig cfg ← parse_cli(["inferentia", "serve", "--model", "/tmp/model.gguf", "--expected-digest", "2fa3f013"])
        assert cfg.expected_digest ≡ "2fa3f013"
    }
    test "matching digest passes the admission gate" {
        assert check_expected_digest("2fa3f013", "2fa3f013") is null
    }
    test "mismatching digest is refused with the pin diagnostic" {
        # Clause 2: the refusal is the thrown cause, which serve's catch maps
        # into the failed state — admission never reaches `ready`, so the
        # model is never served and there is no panic path.
        const string ∪ null refusal ← check_expected_digest("aaaa", "bbbb")
        assert refusal not is null
        assert (refusal coalesce "").contains("aaaa")
        assert (refusal coalesce "").contains("bbbb")
    }
    test "file swapped between admit and materialization is caught" {
        # Clause 3: the re-verify at load time compares against the admitted
        # sha, so swapped bytes throw before load_resident_weights reads.
        const string ∪ null refusal ← check_materialized_digest("admitted-sha", "swapped-sha", "")
        assert refusal not is null
        assert (refusal coalesce "").contains("admitted-sha")
        assert (refusal coalesce "").contains("swapped-sha")
    }
    test "materialized digest equal to admitted passes, with or without the flag" {
        assert check_materialized_digest("same-sha", "same-sha", "") is null
        assert check_materialized_digest("same-sha", "same-sha", "same-sha") is null
    }
    test "materialized digest mismatching the flag is caught" {
        const string ∪ null refusal ← check_materialized_digest("same-sha", "same-sha", "flag-sha")
        assert refusal not is null
        assert (refusal coalesce "").contains("flag-sha")
    }
}
