# =============================================================================
# Port weights — the A1 weight load (U-G)
# =============================================================================
#
# Each F32 tensor of the SmolLM2-360M GGUF is read ONCE (one range read at the
# manifest's absolute offset) and reinterpreted in bulk,
#
#     raw ↦ tensor<f32, [N, K]> via Le
#
# with LITERAL shapes. GGUF stores a matrix with `ne` = [in, out] (ne0 is the
# innermost, fastest axis); the row-major shape the A1 token step wants
# (`gradus:decode_token` `layer_step` / `head_step` / `embed_step`) is the
# REVERSED `ne` = [out, in]. The byte order of the file is already that
# row-major order, so no transpose pass exists on this path, and the tied
# embedding [V, D] serves embed_step and head_step alike.
#
# The shape table below is the validation authority: a tensor whose manifest
# dims (reversed) or element type differ from it is refused by a named
# GgufManifestError (UnknownLayout for the type, BadBounds for dims/length);
# nothing is silently reshaped. A bad byte length inside the conversion is a
# recoverable error and is mapped to BadBounds.
#
# The old NumericBlock host loader in main.fab is a separate path and is not
# touched here. The digest-bound entry (`load_port_model`) stays in main.fab.
# =============================================================================

import from "norma:console" console

import from "gradus:model/gguf_manifest" gguf_manifest

@ public
const int PORT_LAYERS = 32

# ggml type code of F32 in the GGUF tensor table.
const int GGML_TYPE_F32 = 0

@ public
class PortLayer {
    var tensor<f32, [960]> attn_norm
    var tensor<f32, [960, 960]> wq
    var tensor<f32, [320, 960]> wk
    var tensor<f32, [320, 960]> wv
    var tensor<f32, [960, 960]> wo
    var tensor<f32, [960]> ffn_norm
    var tensor<f32, [2560, 960]> wg
    var tensor<f32, [2560, 960]> wu
    var tensor<f32, [960, 2560]> wd
}

@ public
class PortWeights {
    var tensor<f32, [49152, 960]> embed
    var tensor<f32, [960]> out_norm
    var list<PortLayer> layers
}

# ---------------------------------------------------------------------------
# Tables (pure)
# ---------------------------------------------------------------------------

# The per-layer tensor suffixes, in load order.
@ public
fn port_layer_suffixes() → list<string> {
    return [
        "attn_norm.weight",
        "attn_q.weight",
        "attn_k.weight",
        "attn_v.weight",
        "attn_output.weight",
        "ffn_norm.weight",
        "ffn_gate.weight",
        "ffn_up.weight",
        "ffn_down.weight"
    ]
}

# GGUF tensor name: a per-layer suffix under "blk.<layer>.", or the bare
# top-level name when layer < 0.
@ public
fn port_tensor_name(int layer, string suffix) → string {
    if layer ≺ 0 {
        return suffix
    }
    return ("blk." + (layer ↦ string)) + "." + suffix
}

# Expected ROW-MAJOR shape (the reversed GGUF `ne`) per suffix; [] for an
# unknown suffix.
@ public
fn port_shape(string suffix) → list<int> {
    if suffix ≡ "token_embd.weight" { return [49152, 960] }
    if suffix ≡ "output_norm.weight" { return [960] }
    if suffix ≡ "attn_norm.weight" { return [960] }
    if suffix ≡ "ffn_norm.weight" { return [960] }
    if suffix ≡ "attn_q.weight" { return [960, 960] }
    if suffix ≡ "attn_k.weight" { return [320, 960] }
    if suffix ≡ "attn_v.weight" { return [320, 960] }
    if suffix ≡ "attn_output.weight" { return [960, 960] }
    if suffix ≡ "ffn_gate.weight" { return [2560, 960] }
    if suffix ≡ "ffn_up.weight" { return [2560, 960] }
    if suffix ≡ "ffn_down.weight" { return [960, 2560] }
    return []
}

@ public
fn port_elements(list<int> shape) → int {
    var int n ← 1
    var int i ← 0
    while i ≺ shape.length() {
        n ← n * (shape.get(i) coalesce 0)
        i ← i + 1
    }
    return n
}

@ public
fn port_same(list<int> a, list<int> b) → bool {
    if a.length() ≠ b.length() { return false }
    var int i ← 0
    while i ≺ a.length() {
        if (a.get(i) coalesce -1) ≠ (b.get(i) coalesce -2) { return false }
        i ← i + 1
    }
    return true
}

# Total tensors the port load reads: embed + output norm + 9 per layer.
@ public
fn port_tensor_count() → int {
    return 2 + PORT_LAYERS * port_layer_suffixes().length()
}

# ---------------------------------------------------------------------------
# Validation (pure over primitives, so synthetic manifests are plain lists)
# ---------------------------------------------------------------------------

# `ne` is the manifest shape (ne0 first); `rowmajor` the expected row-major
# shape. They must be the same dims in reverse order, and the type must be F32.
@ public
fn port_check_dims(string name, list<int> ne, int dtype, list<int> rowmajor) → void ⇥ gguf_manifest.GgufManifestError {
    if dtype ≠ GGML_TYPE_F32 {
        throw variant gguf_manifest.GgufManifestError.UnknownLayout { message = ("tensor " + name) + " is not F32 (ggml type " + (dtype ↦ string) + ")" }
    }
    if rowmajor.length() ≡ 0 {
        throw variant gguf_manifest.GgufManifestError.BadBounds { message = ("tensor " + name) + " has no expected shape" }
    }
    if ne.length() ≠ rowmajor.length() {
        throw variant gguf_manifest.GgufManifestError.BadBounds { message = ("tensor " + name) + " rank " + (ne.length() ↦ string) + " differs from the expected rank " + (rowmajor.length() ↦ string) }
    }
    var int i ← 0
    while i ≺ ne.length() {
        const int observed ← ne.get(i) coalesce -1
        const int expected ← rowmajor.get(ne.length() - 1 - i) coalesce -2
        if observed ≠ expected {
            throw variant gguf_manifest.GgufManifestError.BadBounds { message = ("tensor " + name) + " ne[" + (i ↦ string) + "]=" + (observed ↦ string) + " differs from the expected " + (expected ↦ string) }
        }
        i ← i + 1
    }
}

# The stored byte range of one tensor after the shape/type checks:
# (absolute_start, byte_length); byte_length must be 4 * elements exactly.
@ public
fn port_locate(gguf_manifest.GgufManifest m, string name, list<int> rowmajor) → tuple<int, int> ⇥ gguf_manifest.GgufManifestError {
    const gguf_manifest.GgufTensorDescriptor d ← gguf_manifest.find_tensor(m, name)
    port_check_dims(name, d.shape, d.dtype_ggml, rowmajor)
    const tuple<int, int> limit ← gguf_manifest.payload_limit(m, name)
    const int want ← port_elements(rowmajor) * 4
    if limit[1] ≠ want {
        throw variant gguf_manifest.GgufManifestError.BadBounds { message = ("tensor " + name) + " stored length " + (limit[1] ↦ string) + " differs from " + (want ↦ string) }
    }
    return limit
}

# ONE range read per tensor through the caller's bounds-checked source.
fn port_read((int, int) → bytes ⇥ gguf_manifest.GgufManifestError source, gguf_manifest.GgufManifest m, string name, list<int> rowmajor) → bytes ⇥ gguf_manifest.GgufManifestError {
    const tuple<int, int> limit ← port_locate(m, name, rowmajor)
    const bytes raw ← source(limit[0], limit[1])
    if raw.length() ≠ limit[1] {
        throw variant gguf_manifest.GgufManifestError.BadSource { message = ("tensor " + name) + " short read" }
    }
    return raw
}

fn port_note(string name) → void {
    console.warn_line("port: loaded " + name)
}

# ---------------------------------------------------------------------------
# Typed conversions: one function per literal shape. The conversion checks
# the byte length itself; a mismatch is a recoverable error mapped to BadBounds.
# ---------------------------------------------------------------------------

fn port_conv_v960(bytes raw, string name) → tensor<f32, [960]> ⇥ gguf_manifest.GgufManifestError {
    do {
        return raw ↦ tensor<f32, [960]> via Le
    }
    catch err {
        throw variant gguf_manifest.GgufManifestError.BadBounds { message = ("tensor " + name) + ": " + err }
    }
}

fn port_conv_m960x960(bytes raw, string name) → tensor<f32, [960, 960]> ⇥ gguf_manifest.GgufManifestError {
    do {
        return raw ↦ tensor<f32, [960, 960]> via Le
    }
    catch err {
        throw variant gguf_manifest.GgufManifestError.BadBounds { message = ("tensor " + name) + ": " + err }
    }
}

fn port_conv_m320x960(bytes raw, string name) → tensor<f32, [320, 960]> ⇥ gguf_manifest.GgufManifestError {
    do {
        return raw ↦ tensor<f32, [320, 960]> via Le
    }
    catch err {
        throw variant gguf_manifest.GgufManifestError.BadBounds { message = ("tensor " + name) + ": " + err }
    }
}

fn port_conv_m2560x960(bytes raw, string name) → tensor<f32, [2560, 960]> ⇥ gguf_manifest.GgufManifestError {
    do {
        return raw ↦ tensor<f32, [2560, 960]> via Le
    }
    catch err {
        throw variant gguf_manifest.GgufManifestError.BadBounds { message = ("tensor " + name) + ": " + err }
    }
}

fn port_conv_m960x2560(bytes raw, string name) → tensor<f32, [960, 2560]> ⇥ gguf_manifest.GgufManifestError {
    do {
        return raw ↦ tensor<f32, [960, 2560]> via Le
    }
    catch err {
        throw variant gguf_manifest.GgufManifestError.BadBounds { message = ("tensor " + name) + ": " + err }
    }
}

fn port_conv_m49152x960(bytes raw, string name) → tensor<f32, [49152, 960]> ⇥ gguf_manifest.GgufManifestError {
    do {
        return raw ↦ tensor<f32, [49152, 960]> via Le
    }
    catch err {
        throw variant gguf_manifest.GgufManifestError.BadBounds { message = ("tensor " + name) + ": " + err }
    }
}

# ---------------------------------------------------------------------------
# Loaders per shape family (layer < 0 selects the top-level name)
# ---------------------------------------------------------------------------

fn port_vec((int, int) → bytes ⇥ gguf_manifest.GgufManifestError source, gguf_manifest.GgufManifest m, int layer, string suffix) → tensor<f32, [960]> ⇥ gguf_manifest.GgufManifestError {
    const string name ← port_tensor_name(layer, suffix)
    const bytes raw ← port_read(source, m, name, port_shape(suffix))
    const tensor<f32, [960]> t ← port_conv_v960(raw, name)
    port_note(name)
    return t
}

fn port_sq((int, int) → bytes ⇥ gguf_manifest.GgufManifestError source, gguf_manifest.GgufManifest m, int layer, string suffix) → tensor<f32, [960, 960]> ⇥ gguf_manifest.GgufManifestError {
    const string name ← port_tensor_name(layer, suffix)
    const bytes raw ← port_read(source, m, name, port_shape(suffix))
    const tensor<f32, [960, 960]> t ← port_conv_m960x960(raw, name)
    port_note(name)
    return t
}

fn port_kv((int, int) → bytes ⇥ gguf_manifest.GgufManifestError source, gguf_manifest.GgufManifest m, int layer, string suffix) → tensor<f32, [320, 960]> ⇥ gguf_manifest.GgufManifestError {
    const string name ← port_tensor_name(layer, suffix)
    const bytes raw ← port_read(source, m, name, port_shape(suffix))
    const tensor<f32, [320, 960]> t ← port_conv_m320x960(raw, name)
    port_note(name)
    return t
}

fn port_up((int, int) → bytes ⇥ gguf_manifest.GgufManifestError source, gguf_manifest.GgufManifest m, int layer, string suffix) → tensor<f32, [2560, 960]> ⇥ gguf_manifest.GgufManifestError {
    const string name ← port_tensor_name(layer, suffix)
    const bytes raw ← port_read(source, m, name, port_shape(suffix))
    const tensor<f32, [2560, 960]> t ← port_conv_m2560x960(raw, name)
    port_note(name)
    return t
}

fn port_down((int, int) → bytes ⇥ gguf_manifest.GgufManifestError source, gguf_manifest.GgufManifest m, int layer, string suffix) → tensor<f32, [960, 2560]> ⇥ gguf_manifest.GgufManifestError {
    const string name ← port_tensor_name(layer, suffix)
    const bytes raw ← port_read(source, m, name, port_shape(suffix))
    const tensor<f32, [960, 2560]> t ← port_conv_m960x2560(raw, name)
    port_note(name)
    return t
}

fn port_embed((int, int) → bytes ⇥ gguf_manifest.GgufManifestError source, gguf_manifest.GgufManifest m) → tensor<f32, [49152, 960]> ⇥ gguf_manifest.GgufManifestError {
    const string name ← port_tensor_name(-1, "token_embd.weight")
    const bytes raw ← port_read(source, m, name, port_shape("token_embd.weight"))
    const tensor<f32, [49152, 960]> t ← port_conv_m49152x960(raw, name)
    port_note(name)
    return t
}

fn port_layer((int, int) → bytes ⇥ gguf_manifest.GgufManifestError source, gguf_manifest.GgufManifest m, int n) → PortLayer ⇥ gguf_manifest.GgufManifestError {
    const tensor<f32, [960]> attn_norm ← port_vec(source, m, n, "attn_norm.weight")
    const tensor<f32, [960, 960]> wq ← port_sq(source, m, n, "attn_q.weight")
    const tensor<f32, [320, 960]> wk ← port_kv(source, m, n, "attn_k.weight")
    const tensor<f32, [320, 960]> wv ← port_kv(source, m, n, "attn_v.weight")
    const tensor<f32, [960, 960]> wo ← port_sq(source, m, n, "attn_output.weight")
    const tensor<f32, [960]> ffn_norm ← port_vec(source, m, n, "ffn_norm.weight")
    const tensor<f32, [2560, 960]> wg ← port_up(source, m, n, "ffn_gate.weight")
    const tensor<f32, [2560, 960]> wu ← port_up(source, m, n, "ffn_up.weight")
    const tensor<f32, [960, 2560]> wd ← port_down(source, m, n, "ffn_down.weight")
    return PortLayer { attn_norm = attn_norm, wq = wq, wk = wk, wv = wv, wo = wo, ffn_norm = ffn_norm, wg = wg, wu = wu, wd = wd }
}

# Every one of the 290 tensors, each read once. `source` is the caller's
# bounds-checked range reader (absolute file offset, length).
@ public
fn load_weights((int, int) → bytes ⇥ gguf_manifest.GgufManifestError source, gguf_manifest.GgufManifest m) → PortWeights ⇥ gguf_manifest.GgufManifestError {
    const tensor<f32, [49152, 960]> embed ← port_embed(source, m)
    const tensor<f32, [960]> out_norm ← port_vec(source, m, -1, "output_norm.weight")
    var list<PortLayer> layers ← []
    var int n ← 0
    while n ≺ PORT_LAYERS {
        layers.append(port_layer(source, m, n))
        n ← n + 1
    }
    return PortWeights { embed = embed, out_norm = out_norm, layers = layers }
}

# ---------------------------------------------------------------------------
# Tests (pure parts)
# ---------------------------------------------------------------------------

describe "port weights shape table" tag "inferentia" {
    test "matrix shapes are the reversed GGUF ne" {
        assert port_same(port_shape("token_embd.weight"), [49152, 960])
        assert port_same(port_shape("attn_q.weight"), [960, 960])
        assert port_same(port_shape("attn_k.weight"), [320, 960])
        assert port_same(port_shape("attn_v.weight"), [320, 960])
        assert port_same(port_shape("attn_output.weight"), [960, 960])
        assert port_same(port_shape("ffn_gate.weight"), [2560, 960])
        assert port_same(port_shape("ffn_up.weight"), [2560, 960])
        assert port_same(port_shape("ffn_down.weight"), [960, 2560])
    }
    test "norm vectors are [960]" {
        assert port_same(port_shape("attn_norm.weight"), [960])
        assert port_same(port_shape("ffn_norm.weight"), [960])
        assert port_same(port_shape("output_norm.weight"), [960])
    }
    test "an unknown suffix has no shape" {
        assert port_shape("rope_freqs.weight").length() ≡ 0
    }
    test "element counts match the stored byte sizes" {
        assert port_elements(port_shape("token_embd.weight")) * 4 ≡ 188743680
        assert port_elements(port_shape("ffn_down.weight")) ≡ 2457600
        assert port_elements(port_shape("attn_norm.weight")) ≡ 960
    }
    test "the load covers 290 tensors" {
        assert port_tensor_count() ≡ 290
        assert port_layer_suffixes().length() ≡ 9
    }
}

describe "port weights name table" tag "inferentia" {
    test "per-layer names carry the block index" {
        assert port_tensor_name(0, "attn_q.weight") ≡ "blk.0.attn_q.weight"
        assert port_tensor_name(31, "ffn_down.weight") ≡ "blk.31.ffn_down.weight"
    }
    test "top-level names are bare" {
        assert port_tensor_name(-1, "token_embd.weight") ≡ "token_embd.weight"
        assert port_tensor_name(-1, "output_norm.weight") ≡ "output_norm.weight"
    }
}

describe "port weights validation" tag "inferentia" {
    test "reversed ne with type F32 passes" {
        do {
            port_check_dims("blk.0.ffn_gate.weight", [960, 2560], 0, [2560, 960])
            port_check_dims("blk.0.attn_norm.weight", [960], 0, [960])
            assert true
        }
        catch err {
            assert false
        }
    }
    test "ne in row-major order (not reversed) is refused" {
        var bool refused ← false
        do {
            port_check_dims("blk.0.ffn_gate.weight", [2560, 960], 0, [2560, 960])
        }
        catch err {
            refused ← true
        }
        assert refused
    }
    test "a wrong dimension is refused" {
        var bool refused ← false
        do {
            port_check_dims("blk.0.attn_k.weight", [960, 321], 0, [320, 960])
        }
        catch err {
            refused ← true
        }
        assert refused
    }
    test "a wrong rank is refused" {
        var bool refused ← false
        do {
            port_check_dims("blk.0.attn_norm.weight", [960, 1], 0, [960])
        }
        catch err {
            refused ← true
        }
        assert refused
    }
    test "a non-F32 type is refused as UnknownLayout" {
        var string cause ← ""
        do {
            port_check_dims("blk.0.attn_q.weight", [960, 960], 12, [960, 960])
        }
        catch err {
            cause ← err.message
        }
        assert cause ≠ ""
    }
    test "an unknown expected shape is refused" {
        var bool refused ← false
        do {
            const list<int> none_expected ← port_shape("rope_freqs.weight")
            port_check_dims("rope_freqs.weight", [32], 0, none_expected)
        }
        catch err {
            refused ← true
        }
        assert refused
    }
}

describe "port weights conversion refusal" tag "inferentia" {
    test "a short byte range is a recoverable BadBounds, not a reshape" {
        const bytes raw ← |00 00 80 3f|
        var string cause ← ""
        do {
            const tensor<f32, [960]> t ← port_conv_v960(raw, "blk.0.attn_norm.weight")
            cause ← "converted"
        }
        catch err {
            cause ← err.message
        }
        assert cause ≠ ""
        assert cause ≠ "converted"
    }
}
