# =============================================================================
# admission-gate — executable proof of the U2 admission path + the U7
# admission-failure matrix (I1 U2 / U7)
# =============================================================================
#
# This no-host harness runs the admission contract (`solum:digestio` +
# `solum:hauri` → `gradus:model/gguf` admit) on one GGUF path and mirrors
# the D5 process exit contract:
#
#   exit 0 — admission succeeded; the verified whole-file SHA-256 is printed.
#   exit 2 — admission failed; the typed cause (io / size / structure / SHA-256
#            mismatch) is printed.
#
# Native host is required so `solum:digestio` / `solum:hauri` are real host
# calls (missing-file IO is catchable CapsulaMala, exit 2). It never calls
# generate, so no weight materialization happens on this path (the U2
# "no weight materialization on failure" gate).
#
# The server (src/main.fab) declares the same binding and drives the same
# lifecycle transitions; its binary link is blocked on the recorded toolchain
# staleness (see src/main.fab and the U2 closeout).
#
# Usage: admission-gate <model-path>
# The U7 failure fixtures (malformed / wrong-arch / wrong-quant /
# digest-mismatch / unknown-key copies of the pinned row) are prepared by
# fixtures.py and the full matrix (typed cause + exit 0/2 + listener
# regression) is validated by run.sh in this directory.

import from "gradus:model/capsule" capsula
import from "gradus:model/gguf" gguf

# The pinned row's verified whole-file SHA-256 (gi0-model-contract v1.0.0 §1;
# i1-discovery.md identity table).
fn pinned_sha() → string {
    return "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2"
}

fn stdout_write(string text) → void {
    return call 'consolum:dic' (text) ↦ void
}

fn stderr_write(string text) → void {
    return call 'consolum:mone' (text) ↦ void
}

# Never returns on success; the generated wrapper panics if it returns.
fn exit_with(int code) → void {
    return call 'processus:exi' (code) ↦ void
}

fn bytes_as_u8(bytes raw) → list<int<u8>> {
    var list<int<u8>> out ← []
    var int i ← 0
    while i < raw.length() {
        out.append(raw.get(i) coalesce (0 ∷ int<u8>))
        i ← i + 1
    }
    return out
}

# Host IO payloads are String. A ⇥ string wrapper lets them propagate
# instead of aborting; admit_model's cape maps them into CapsulaMala.
fn host_digestio(string path) → string ⇥ string {
    return call 'solum:digestio' (path) ↦ string
}

fn host_hauri(string path) → bytes ⇥ string {
    return call 'solum:hauri' (path) ↦ bytes
}

# Path → host digest + bytes → gradus admit. Returns the carried digest.
fn admit_model(string path) → string ⇥ gguf.GgufError {
    var string digest ← ""
    var bytes raw ← ||
    do {
        digest ← host_digestio(path)
        raw ← host_hauri(path)
    }
    catch err {
        throw variant CapsulaMala { message = err }
    }
    const list<int<u8>> data ← bytes_as_u8(raw)
    const capsula.Capsule cap ← gguf.admit(data, digest, 37, 290, 361821120, 65, 16, 176, 16, 17)
    return cap.digest()
}

main args argv {
    if argv.length() < 2 {
        stderr_write("usage: admission-gate <model-path>\n")
        exit_with(1)
    }
    const string path ← argv.get(1) coalesce ""
    do {
        const string sha ← admit_model(path)
        stdout_write("admitted: " + sha + "\n")
        if sha ≡ pinned_sha() {
            stdout_write("PASS admission: digest equals the pinned row (2fa3f013…)\n")
        } else {
            stdout_write("FAIL admission: digest " + sha + " does not equal the pinned row\n")
            exit_with(2)
        }
    }
    catch err {
        stdout_write("rejected: " + gguf.message(err) + "\n")
        exit_with(2)
    }
}
