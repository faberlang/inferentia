# =============================================================================
# generate-gate — executable proof of the U4 generation path (I1 U4)
# =============================================================================
#
# Drives G2 `gradus:generation.generate_dense_with_stop` (factory spelling
# existence-checked in gradus docs/api-reference.md) through the U4 config
# surface on the pinned SmolLM2 row:
#
#   1. Default stop is `eog_stop()`: greedy continuation is [30, 2].
#   2. `ignore_eos()` continuation is the U5 / record.json 16-token golden.
#   3. Resident model: weights load exactly once; two sequential default
#      runs return the same [30, 2].
#   4. Gradus reject rows: construct_generation / generate typed causes
#      (fail closed, never silently ignored).
#
# Exit: 0 on ALL PASS, 1 on any FAIL.
# Model identity: pinned SmolLM2-360M-Instruct-Q4_K_M.gguf
#   sha256 2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2
# Usage: generate-gate [model-path]

import from "gradus:attention/rope" rope
import from "gradus:cache/kv" kv
import from "gradus:cache/structure" structure
import from "gradus:decode" decode
import from "gradus:generation/config" config
import from "gradus:generation/decoder" decoder
import from "gradus:generation/dense" dense_gen
import from "gradus:model/artifact" artifact
import from "gradus:model/dense" dense
import from "gradus:model/gguf_manifest" gguf_manifest
import from "gradus:model/tensor_payload" tensor_payload
import from "gradus:model/tensor_view" tensor_view
import from "gradus:tensor" tensor
import from "gradus:tokenizer/bpe" tokenizator
import from "norma:solum" solum

# --- I/O + exit ------------------------------------------------------------
fn stdout_write(string text) → void {
    return call 'consolum:dic' (text) ↦ void
}

fn stderr_write(string text) → void {
    return call 'consolum:mone' (text) ↦ void
}

fn exit_with(int code) → void {
    return call 'processus:exi' (code) ↦ void
}

fn fail(string why) → void {
    stdout_write("FAIL " + why + "\n")
    exit_with(1)
}

# --- Pinned facts (i1-discovery §6.1) ---------------------------------------
fn pinned_path() → string {
    return "/Users/ianzepp/ai/models/SmolLM2-360M-Instruct-Q4_K_M.gguf"
}

fn pinned_digest() → string {
    return "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2"
}

fn pinned_bytes() → int { return 270590880 }
fn pinned_data_offset() → int { return 1787040 }
fn pinned_slice_cap() → int { return 16777216 }
fn pinned_vocab() → int { return 49152 }

fn pinned_prompt() → list<int> {
    return [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]
}

fn default_eog_tokens() → list<int> {
    return [30, 2]
}

fn record_prefix_16() → list<int> {
    return [30, 198, 198, 504, 808, 6330, 314, 253, 2232, 4814, 282, 1027, 28, 979, 260, 1796]
}

# --- Config surface --------------------------------------------------------
class GenerateConfig {
    var int contextus
    var int magna_promptus
    var int maxima_verborum
    var int semen
    var float temperatura
    var int top_k
    var float top_p
    var float min_p
    var float poena_repetitionis
}

fn frozen_config(int max_tokens) → GenerateConfig {
    return GenerateConfig {
        contextus = 8192,
        magna_promptus = 1,
        maxima_verborum = max_tokens,
        semen = 1,
        temperatura = 0.0,
        top_k = 0,
        top_p = 1.0,
        min_p = 0.0,
        poena_repetitionis = 1.0
    }
}

fn to_generation(GenerateConfig cfg, list<int> eog_ids) → config.GenerationConfig ⇥ config.GenerationError {
    return config.construct_generation(cfg.contextus, cfg.magna_promptus, cfg.maxima_verborum, cfg.semen, cfg.temperatura ↦ f32, cfg.top_k, cfg.top_p ↦ f32, cfg.min_p ↦ f32, cfg.poena_repetitionis ↦ f32, eog_ids)
}

# --- Resident dense model --------------------------------------------------
class ResidentModel {
    var bool ready
    var dense_gen.DenseEngine engine
    var tensor.Tensor embed
    var tensor.Tensor norm_s
    var list<list<tensor.Tensor>> strata
    var structure.KVStructure structure
    var list<int> eog_ids
}

fn empty_resident() → ResidentModel {
    return ResidentModel {
        ready = false,
        engine = dense_gen.default_dense_engine(),
        embed = tensor.default(),
        norm_s = tensor.default(),
        strata = [],
        structure = structure.default_kv_structure(),
        eog_ids = []
    }
}

fn file_size(string path) → int {
    return solum.byte_length(path)
}

fn read_range(string path, int start, int length) → bytes {
    return solum.read_range(path, start, length)
}

fn source_range(string path, int total, int initium, int longitudo) → gguf_manifest.SourceRead {
    if initium < 0 or longitudo < 0 or initium > total - longitudo {
        return gguf_manifest.SourceRead { successus = false, bytes = ||, message = "range request exceeds the artifact" }
    }
    const bytes raw ← read_range(path, initium, longitudo)
    if raw.length() ≠ longitudo {
        return gguf_manifest.SourceRead { successus = false, bytes = ||, message = "short range read" }
    }
    return gguf_manifest.SourceRead { successus = true, bytes = raw, message = "" }
}

fn prefix_range(list<int> prefix, int initium, int longitudo) → gguf_manifest.SourceRead {
    if initium < 0 or longitudo < 0 or initium > prefix.length() - longitudo {
        return gguf_manifest.SourceRead { successus = false, bytes = ||, message = "inspection attempted to read the tensor data region" }
    }
    const list<int> segment ← prefix.slice(initium, initium + longitudo)
    const bytes raw ← segment ↦ bytes
    return gguf_manifest.SourceRead { successus = true, bytes = raw, message = "" }
}

fn ends(string s, string tail) → bool {
    if tail.length() > s.length() { return false }
    return s.slice(s.length() - tail.length(), s.length()) ≡ tail
}

fn slot(string nomen) → int {
    if ends(nomen, ".input_layernorm") { return 0 }
    if ends(nomen, ".self_attn.q_proj") { return 1 }
    if ends(nomen, ".self_attn.k_proj") { return 2 }
    if ends(nomen, ".self_attn.v_proj") { return 3 }
    if ends(nomen, ".self_attn.o_proj") { return 4 }
    if ends(nomen, ".post_attention_layernorm") { return 5 }
    if ends(nomen, ".mlp.gate_proj") { return 6 }
    if ends(nomen, ".mlp.up_proj") { return 7 }
    if ends(nomen, ".mlp.down_proj") { return 8 }
    return -1
}

fn block_elements(tensor_view.TensorView v) → int {
    match v.layout {
        case gguf_manifest.Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            return elementa_per_blockum
        }
        case gguf_manifest.Ignota const typo {
            return 0
        }
    }
}

fn window(int remaining, int block) → int {
    if remaining ≤ pinned_slice_cap() { return remaining }
    const int aligned ← (pinned_slice_cap() / block) * block
    if aligned < block { return block }
    return aligned
}

fn limits(gguf_manifest.GgufManifest m, string gguf_name) → tuple<int, int> {
    do {
        return gguf_manifest.limes_payloadis(m, gguf_name)
    }
    catch err {
        panic "payload range failed for " + gguf_name + ": " + gguf_manifest.message(err)
    }
}

fn bind_view(gguf_manifest.GgufManifest m, tensor_payload.TensorPayload p) → tensor_view.TensorView {
    do {
        return tensor_view.links(m, p)
    }
    catch err {
        panic "view bind failed for " + p.name + ": " + tensor_view.message(err)
    }
}

fn slice_view(tensor_view.TensorView v, int off, int n, (int, int) → gguf_manifest.SourceRead fons) → list<f32> {
    do {
        return tensor_view.materialize_slice(v, off, n, fons)
    }
    catch err {
        panic "window materialize failed for " + v.name + ": " + tensor_view.message(err)
    }
}

fn make_tensor(list<f32> datos, list<int> forma) → tensor.Tensor {
    do {
        return tensor.construct(datos, forma)
    }
    catch err {
        panic "tensor construct failed: " + tensor.message(err)
    }
}

fn materialize(string via, int total, gguf_manifest.GgufManifest m, string gguf_name) → tensor.Tensor {
    const tuple<int, int> limes ← limits(m, gguf_name)
    const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
        name = gguf_name,
        absolute_start = limes[0],
        length = limes[1],
        bytes = ||
    }
    const tensor_view.TensorView v ← bind_view(m, p)
    const int block ← block_elements(v)
    if block < 1 {
        panic "tensor layout has no block size: " + gguf_name
    }
    var list<f32> datos ← []
    var int off ← 0
    while off < v.elements {
        const int n ← window(v.elements - off, block)
        const list<f32> part ← slice_view(
            v,
            off,
            n,
            (int initium, int longitudo) → gguf_manifest.SourceRead ∴ source_range(via, total, initium, longitudo)
        )
        var int pi ← 0
        while pi < part.length() {
            datos.append(part.get(pi) coalesce (0.0 ∷ f32))
            pi ← pi + 1
        }
        off ← off + n
    }
    return make_tensor(datos, v.shape)
}

fn gguf_name(string family, int stratum) → string {
    if family ≡ "model.embed_tokens" { return "token_embd.weight" }
    if family ≡ "model.norm" { return "output_norm.weight" }
    if family ≡ "lm_head" { return "token_embd.weight" }
    if stratum < 0 or stratum ≥ 32 {
        panic "layer index outside the frozen llama layer range: " + (stratum ↦ string)
    }
    if family ≡ "model.layers.input_layernorm" { return ("blk." + (stratum ↦ string)) + ".attn_norm.weight" }
    if family ≡ "model.layers.self_attn.q_proj" { return ("blk." + (stratum ↦ string)) + ".attn_q.weight" }
    if family ≡ "model.layers.self_attn.k_proj" { return ("blk." + (stratum ↦ string)) + ".attn_k.weight" }
    if family ≡ "model.layers.self_attn.v_proj" { return ("blk." + (stratum ↦ string)) + ".attn_v.weight" }
    if family ≡ "model.layers.self_attn.o_proj" { return ("blk." + (stratum ↦ string)) + ".attn_output.weight" }
    if family ≡ "model.layers.post_attention_layernorm" { return ("blk." + (stratum ↦ string)) + ".ffn_norm.weight" }
    if family ≡ "model.layers.mlp.gate_proj" { return ("blk." + (stratum ↦ string)) + ".ffn_gate.weight" }
    if family ≡ "model.layers.mlp.up_proj" { return ("blk." + (stratum ↦ string)) + ".ffn_up.weight" }
    if family ≡ "model.layers.mlp.down_proj" { return ("blk." + (stratum ↦ string)) + ".ffn_down.weight" }
    panic "unknown canonical tensor name: " + family
}

fn kmajor_to_linear(tensor.Tensor t) → tensor.Tensor {
    const list<int> f ← t.shape()
    if f.length() ≠ 2 {
        panic "linear weight must be rank 2"
    }
    const int k ← f.get(0) coalesce 1
    const int n ← f.get(1) coalesce 1
    var list<f32> out ← []
    var int i ← 0
    while i < k {
        var int j ← 0
        while j < n {
            out.append(t.data.get(j * k + i) coalesce (0.0 ∷ f32))
            j ← j + 1
        }
        i ← i + 1
    }
    return make_tensor(out, [k, n])
}

fn linear_family(string family) → bool {
    if family ≡ "lm_head" { return true }
    if ends(family, ".self_attn.q_proj") { return true }
    if ends(family, ".self_attn.k_proj") { return true }
    if ends(family, ".self_attn.v_proj") { return true }
    if ends(family, ".self_attn.o_proj") { return true }
    if ends(family, ".mlp.gate_proj") { return true }
    if ends(family, ".mlp.up_proj") { return true }
    if ends(family, ".mlp.down_proj") { return true }
    return false
}

fn load_one(string via, int total, gguf_manifest.GgufManifest m, string family, int stratum) → tensor.Tensor {
    const string name ← gguf_name(family, stratum)
    const tensor.Tensor stored ← materialize(via, total, m, name)
    if linear_family(family) {
        return kmajor_to_linear(stored)
    }
    return stored
}

fn lookup(string nomen, int stratum, tensor.Tensor embed, tensor.Tensor norm_s, list<list<tensor.Tensor>> strata) → dense.Lookup {
    if nomen ≡ "model.embed_tokens" { return dense.Lookup { successus = true, tensorem = embed, message = "" } }
    if nomen ≡ "model.norm" { return dense.Lookup { successus = true, tensorem = norm_s, message = "" } }
    if stratum < 0 or stratum ≥ strata.length() {
        return dense.Lookup { successus = false, tensorem = embed, message = "layer out of range: " + (stratum ↦ string) }
    }
    const int s ← slot(nomen)
    if s < 0 {
        return dense.Lookup { successus = false, tensorem = embed, message = "unknown canonical tensor: " + nomen }
    }
    var list<tensor.Tensor> missing ← []
    const list<tensor.Tensor> row ← strata.get(stratum) coalesce missing
    if s ≥ row.length() {
        return dense.Lookup { successus = false, tensorem = embed, message = "layer slot missing: " + nomen }
    }
    const tensor.Tensor t ← row.get(s) coalesce embed
    return dense.Lookup { successus = true, tensorem = t, message = "" }
}

fn indices(int n) → list<int> {
    var list<int> out ← []
    var int i ← 0
    while i < n {
        out.append(i)
        i ← i + 1
    }
    return out
}

fn inspect_model(string path) → gguf_manifest.GgufManifest {
    const int total ← file_size(path)
    if total ≠ pinned_bytes() {
        panic "model byte length mismatch: observed=" + (total ↦ string) + " expected=" + (pinned_bytes() ↦ string)
    }
    const int data_offset ← pinned_data_offset()
    const bytes prefix_bytes ← read_range(path, 0, data_offset)
    if prefix_bytes.length() ≠ data_offset {
        panic "table-prefix read was short"
    }
    const value prefix_valor ← prefix_bytes ↦ value
    const list<int> prefix ← prefix_valor ↦ list<int>
    const artifact.ContentIdentity identitas ← artifact.ContentIdentity {
        algorithm = "sha-256",
        digest = pinned_digest(),
        length = total
    }
    var gguf_manifest.GgufManifest admitted ← gguf_manifest.GgufManifest {
        identitas = identitas,
        version = 0,
        concordatio = 0,
        data_inceptum = 0,
        artifact_length = 0,
        metadata = [],
        tensors = []
    }
    do {
        admitted ← gguf_manifest.inspect(
            (int initium, int longitudo) → gguf_manifest.SourceRead ∴ prefix_range(prefix, initium, longitudo),
            total,
            identitas
        )
    }
    catch err {
        panic "manifest admission failed: " + gguf_manifest.message(err)
    }
    return admitted
}

fn load_resident(string path) → ResidentModel {
    const int total ← file_size(path)
    const gguf_manifest.GgufManifest admitted ← inspect_model(path)
    var list<int> eog_ids ← []
    do {
        const tokenizator.Tokenizer tokenizer ← tokenizator.build(admitted)
        eog_ids ← tokenizator.artifact_eog(tokenizer)
    }
    catch err {
        panic "tokenizer admission failed: " + tokenizator.message(err)
    }
    var tensor.Tensor embed ← tensor.default()
    var tensor.Tensor norm_s ← tensor.default()
    embed ← load_one(path, total, admitted, "model.embed_tokens", 0)
    norm_s ← load_one(path, total, admitted, "model.norm", 0)

    const list<string> families ← [
        "model.layers.input_layernorm",
        "model.layers.self_attn.q_proj",
        "model.layers.self_attn.k_proj",
        "model.layers.self_attn.v_proj",
        "model.layers.self_attn.o_proj",
        "model.layers.post_attention_layernorm",
        "model.layers.mlp.gate_proj",
        "model.layers.mlp.up_proj",
        "model.layers.mlp.down_proj"
    ]
    var list<list<tensor.Tensor>> strata ← []
    var int stratum ← 0
    while stratum < 32 {
        var list<tensor.Tensor> row ← []
        var int f ← 0
        while f < families.length() {
            row.append(load_one(path, total, admitted, families.get(f) coalesce "", stratum))
            f ← f + 1
        }
        strata.append(row)
        stderr_write("generate-gate: loaded layer " + (stratum ↦ string) + "\n")
        stratum ← stratum + 1
    }

    var rope.RopeConfig rope_cfg ← rope.default()
    do {
        rope_cfg ← rope.construct_rope_config(100000.0 ∷ f32, 1.0 ∷ f32, rope.consecutive_policy())
    }
    catch err {
        panic "rope config failed: " + err.message
    }

    const dense.DenseConfig architecture ← dense.DenseConfig {
        layers = 32,
        heads = 15,
        kv_heads = 5,
        head_dim = 64,
        hidden_dim = 960,
        vocab = pinned_vocab(),
        tied = true
    }

    var structure.KVStructure kv_structure ← structure.default_kv_structure()
    do {
        const structure.LayerSet set ← structure.construct_layer_set(indices(32), structure.dense_structure(), 5, 64)
        var list<structure.LayerSet> sets ← []
        sets.append(set)
        kv_structure ← structure.construct_kv_structure(
            sets,
            structure.kv_dtype_f32(),
            structure.kv_dtype_f32(),
            structure.v_layout_transposed(),
            structure.sharing_gqa(),
            structure.attention_classic(),
            15,
            8192,
            8192
        )
    }
    catch err {
        panic "kv structure failed: " + err.message
    }

    const dense_gen.DenseEngine engine ← dense_gen.construct_dense_engine(architecture, 0.00001 ∷ f32, 0.125 ∷ f32, 64, rope_cfg)
    return ResidentModel {
        ready = true,
        engine = engine,
        embed = embed,
        norm_s = norm_s,
        strata = strata,
        structure = kv_structure,
        eog_ids = eog_ids
    }
}

fn fresh_caches(ResidentModel model) → list<kv.KVCache> {
    do {
        return dense.empty_caches(model.structure, "smollm2", "360m", "f32-staged", "smollm")
    }
    catch err {
        panic "empty caches failed: " + dense.message(err)
    }
}

fn run_generate(GenerateConfig cfg, list<int> prompt, ResidentModel model, decoder.StopPolicy stop) → list<int> ⇥ config.GenerationError {
    const config.GenerationConfig g ← to_generation(cfg, model.eog_ids)
    var list<kv.KVCache> layers ← []
    if model.ready {
        layers ← fresh_caches(model)
    }
    return dense_gen.generate_dense_with_stop(
        g,
        prompt,
        model.engine,
        (string n, int s) → dense.Lookup ∴ lookup(n, s, model.embed, model.norm_s, model.strata),
        layers,
        decode.fresh_cancellation(),
        stop
    )
}

# --- Check helpers ----------------------------------------------------------
fn expect_reject(GenerateConfig cfg, list<int> prompt, string needle) → void {
    var int unexpected_count ← -1
    var bool raised ← false
    var string raise_error ← ""
    do {
        const list<int> tokens ← run_generate(cfg, prompt, empty_resident(), decoder.eog_stop())
        unexpected_count ← tokens.length()
    }
    catch err {
        raised ← true
        raise_error ← err.message
    }
    if not raised {
        fail("expected rejection containing '" + needle + "' but generate returned " + (unexpected_count ↦ string) + " tokens")
    }
    const string pass_line ← "PASS reject: " + needle
    const string fail_line ← "rejection for '" + needle + "' got: "
    if raise_error.contains(needle) {
        stdout_write(pass_line + "\n")
    } else {
        fail(fail_line + raise_error)
    }
}

fn expect_reject_wire(string wire, string needle) → void {
    var string raise_error ← ""
    do {
        const config.GenerationConfig g ← config.deserialize_generation(wire)
        fail("expected wire rejection containing '" + needle + "' but deserialize returned context " + (g.context ↦ string))
    }
    catch err {
        raise_error ← err.message
    }
    const string pass_line ← "PASS reject: " + needle
    const string fail_line ← "rejection for '" + needle + "' got: "
    if raise_error.contains(needle) {
        stdout_write(pass_line + "\n")
    } else {
        fail(fail_line + raise_error)
    }
}

fn sequences_equal(list<int> actual, list<int> expected) → bool {
    if actual.length() ≠ expected.length() { return false }
    var int i ← 0
    while i < actual.length() {
        const int a ← actual.get(i) coalesce -1
        const int b ← expected.get(i) coalesce -2
        if a ≠ b { return false }
        i ← i + 1
    }
    return true
}

fn print_int_list(string label, list<int> ids) → void {
    stdout_write(label + ": [")
    var int i ← 0
    while i < ids.length() {
        const int t ← ids.get(i) coalesce 0
        if i > 0 {
            stdout_write(",")
        }
        stdout_write(t ↦ string)
        i ← i + 1
    }
    stdout_write("]\n")
}

fn expect_p10_tokenization() → void {
    const list<int> record_prompt_tokens ← [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]
    const list<int> p10 ← pinned_prompt()
    if sequences_equal(p10, record_prompt_tokens) {
        stdout_write("PASS U5 tokenization: P10 == record.json prompt_tokens\n")
    } else {
        fail("U5 tokenization: P10 != record.json prompt_tokens")
    }
}

fn expect_sequence(GenerateConfig cfg, list<int> prompt, ResidentModel model, decoder.StopPolicy stop, list<int> expected, string label) → void {
    var list<int> actual ← []
    var bool raised ← false
    var string raise_error ← ""
    do {
        const list<int> tokens ← run_generate(cfg, prompt, model, stop)
        actual ← tokens
    }
    catch err {
        raised ← true
        raise_error ← err.message
    }
    if raised {
        fail(label + " raised: " + raise_error)
    }
    print_int_list(label + " observed", actual)
    if sequences_equal(actual, expected) {
        stdout_write("PASS " + label + "\n")
    } else {
        fail(label + " token sequence mismatch")
    }
}

# --- Main -------------------------------------------------------------------
main args argv {
    stdout_write("generate-gate: I1 U4 generate_dense_with_stop proof\n")

    print_int_list("U5 P10 (pinned prompt tokens)", pinned_prompt())
    expect_p10_tokenization()
    print_int_list("U5 default EOG-stop", default_eog_tokens())
    print_int_list("U5 record.json generated_tokens[0..16] (IgnoreEos)", record_prefix_16())

    # Gradus reject rows first — construct_generation / generate_dense
    # validation only; dummy resident, no weight load.
    expect_reject_wire("generation/config/1.0.0/8192/1/4/1/0/0/1/0/1/bogus", "malformed")
    expect_reject(GenerateConfig { contextus = 8192, magna_promptus = 1, maxima_verborum = 0, semen = 1, temperatura = 0.0, top_k = 0, top_p = 1.0, min_p = 0.0, poena_repetitionis = 1.0 }, pinned_prompt(), "maximum generated tokens must be at least one")
    expect_reject(GenerateConfig { contextus = 8, magna_promptus = 1, maxima_verborum = 16, semen = 1, temperatura = 0.0, top_k = 0, top_p = 1.0, min_p = 0.0, poena_repetitionis = 1.0 }, pinned_prompt(), "maximum generated tokens must fit within the context")
    expect_reject(GenerateConfig { contextus = 8192, magna_promptus = 1, maxima_verborum = 4, semen = 1, temperatura = -1.0, top_k = 0, top_p = 1.0, min_p = 0.0, poena_repetitionis = 1.0 }, pinned_prompt(), "temperature must be non-negative")
    expect_reject(GenerateConfig { contextus = 8192, magna_promptus = 1, maxima_verborum = 4, semen = 1, temperatura = 0.0, top_k = 0, top_p = 2.0, min_p = 0.0, poena_repetitionis = 1.0 }, pinned_prompt(), "top-p must be within [0, 1]")
    expect_reject(GenerateConfig { contextus = 8192, magna_promptus = 1, maxima_verborum = 4, semen = 0, temperatura = 0.0, top_k = 0, top_p = 1.0, min_p = 0.0, poena_repetitionis = 1.0 }, pinned_prompt(), "seed must be at least one")
    expect_reject(frozen_config(4), [], "needs at least one prompt token")

    var string via ← pinned_path()
    if argv.length() ≥ 2 {
        via ← argv.get(1) coalesce via
    }
    stdout_write("generate-gate: model.path=" + via + "\n")
    stderr_write("generate-gate: model load 1 (resident — loaded exactly once)\n")

    const ResidentModel model ← load_resident(via)

    expect_sequence(frozen_config(16), pinned_prompt(), model, decoder.eog_stop(), default_eog_tokens(), "default eog_stop == [30, 2]")

    var list<int> r2 ← []
    var bool r2_raised ← false
    var string r2_error ← ""
    do {
        const list<int> tokens ← run_generate(frozen_config(16), pinned_prompt(), model, decoder.eog_stop())
        r2 ← tokens
    }
    catch err {
        r2_raised ← true
        r2_error ← err.message
    }
    if r2_raised {
        fail("request2 raised: " + r2_error)
    }
    if sequences_equal(r2, default_eog_tokens()) {
        stdout_write("PASS request2: identical [30, 2], resident model (no reload)\n")
    } else {
        fail("request2 tokens differ from default EOG-stop (resident-model violation)")
    }

    expect_sequence(frozen_config(16), pinned_prompt(), model, decoder.ignore_eos(), record_prefix_16(), "ignore_eos == record.json prefix")

    stdout_write("GENERATE GATE ALL PASS\n")
}
